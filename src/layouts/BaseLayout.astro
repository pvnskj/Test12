---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/scan-portfolio.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  bareMain?: boolean;
}

const {
  title = 'Venkata Parimi | Senior Technical Product Owner',
  description = 'Senior Technical Product Owner focused on enterprise systems, workflow platforms, data integrity, technical product decisions, and measurable value.',
  image,
  bareMain = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = image ? new URL(image, Astro.site ?? Astro.url.origin) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="ambient-grid" aria-hidden="true"></div>

    <header class="site-header">
      <div class="shell header-inner glass-bar">
        <a class="brand" href={base} aria-label="Venkata Parimi home">
          <span class="brand-mark" aria-hidden="true">VP</span>
          <span class="brand-copy">
            <strong>Venkata Parimi</strong>
            <span>Senior Technical Product Owner</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href={`${base}#work`}>Work</a>
          <a href={`${base}#approach`}>Approach</a>
          <a href="https://github.com/pvnskj" rel="me">GitHub</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            <a href={`${base}#work`}>Work</a>
            <a href={`${base}#approach`}>Approach</a>
            <a href="https://github.com/pvnskj" rel="me">GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    {bareMain ? <div id="main-content"><slot /></div> : <main id="main-content"><slot /></main>}

    <footer class="site-footer">
      <div class="shell compact-footer">
        <p>© {new Date().getFullYear()} Venkata Parimi · Senior Technical Product Owner</p>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href={`${base}#work`}>Work</a>
          <a href={`${base}#approach`}>Approach</a>
          <a href="https://github.com/pvnskj" rel="me">GitHub</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      const bindMobileNavigation = () => {
        document.querySelectorAll('.mobile-nav a').forEach((link) => {
          if (link.dataset.navBound === 'true') return;
          link.dataset.navBound = 'true';
          link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
        });
      };

      bindMobileNavigation();
      document.addEventListener('astro:page-load', bindMobileNavigation);
    </script>
  </body>
</html>

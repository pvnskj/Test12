  .epic-header{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:24px;padding:28px}.category-pill{display:inline-flex;padding:6px 9px;border-radius:999px;background:rgba(234,240,255,.9);font-size:.56rem;font-weight:850;letter-spacing:.055em;color:#4a67b0}.epic-main h1{margin:12px 0 9px;font-size:clamp(2.25rem,4.2vw,3.65rem);line-height:1;letter-spacing:-.045em;color:#123455}.epic-main>p{max-width:780px;margin:0;color:#617991;font-size:.87rem;line-height:1.58}.approach-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:17px}.approach-tags span{padding:5px 8px;border:1px solid rgba(48,99,176,.1);border-radius:999px;background:rgba(248,251,255,.76);font-size:.54rem;font-weight:780;color:#59738e}.epic-facts{display:grid;grid-template-columns:repeat(3,1fr);align-self:stretch;border-left:1px solid rgba(18,52,85,.08)}.epic-facts div{display:flex;flex-direction:column;justify-content:center;padding:12px 13px;border-right:1px solid rgba(18,52,85,.07)}.epic-facts div:last-child{border-right:0}.epic-facts small{font-size:.48rem;font-weight:820;text-transform:uppercase;letter-spacing:.07em;color:#8497aa}.epic-facts strong{margin:5px 0 2px;font-size:1rem;color:#245d9d}.epic-facts span{font-size:.54rem;line-height:1.35;color:#6f859a}
  .evidence-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:10px}.evidence-strip article{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 17px}.evidence-strip article>div{display:grid}.evidence-strip span{font-size:.49rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em;color:#8296a8}.evidence-strip strong{font-size:1.18rem;color:#1f62bf}.evidence-strip p{max-width:135px;margin:0;text-align:right;font-size:.59rem;line-height:1.35;color:#647d94}

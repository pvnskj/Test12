  .decision-table{overflow:hidden;padding:0}.decision-table article{display:grid;grid-template-columns:38px minmax(200px,.42fr) minmax(0,1fr);gap:14px;align-items:center;padding:15px 18px;border-bottom:1px solid rgba(18,52,85,.07)}.decision-table article:last-child{border-bottom:0}.decision-table b{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:rgba(230,239,255,.92);font-size:.55rem;color:#3266b5}.decision-table h3{margin:0;font-size:.76rem;color:#183b5b}.decision-table p{margin:0;color:#697f94;font-size:.66rem;line-height:1.47}
  .focus-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.65fr);gap:30px;align-items:end;margin-bottom:14px}.focus-heading .section-label{margin:0}.focus-heading>p{margin:0;color:#6b8297;font-size:.68rem;line-height:1.5}.feature-list{display:grid;gap:8px}.feature-item{overflow:hidden;padding:0}.feature-item summary{display:grid;grid-template-columns:92px minmax(0,1fr) 120px 28px;gap:14px;align-items:center;padding:16px 18px;cursor:pointer;list-style:none}.feature-item summary::-webkit-details-marker{display:none}.feature-item[open]{border-color:rgba(46,100,185,.22);box-shadow:0 22px 55px rgba(40,72,115,.10)}.feature-key{display:flex;align-items:center;gap:9px}.feature-key span{font-size:.54rem;font-weight:850;color:#3264ad}.feature-key b{display:grid;place-items:center;width:24px;height:24px;border-radius:7px;background:rgba(232,240,255,.92);font-size:.53rem;color:#4d72ad}.feature-summary-copy h3{margin:0 0 3px;font-size:.83rem;color:#163858}.feature-summary-copy p{margin:0;color:#6d8397;font-size:.63rem;line-height:1.4}.feature-signal{text-align:right}.feature-signal strong{display:block;font-size:.84rem;color:#2162bd}.feature-signal span{font-size:.48rem;text-transform:uppercase;letter-spacing:.07em;color:#8295a7}.feature-toggle{display:grid;place-items:center;font-size:1rem;color:#64809a;transition:transform .2s ease}.feature-item[open] .feature-toggle{transform:rotate(45deg)}

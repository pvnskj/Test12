ock;margin-top:5px;font-size:1.25rem;color:#2162bd}.feature-evidence h4{margin:2px 0}.feature-evidence span{font-size:.48rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#7e92a5}
  .evidence-note{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:30px;align-items:center;margin-top:40px;padding:20px}.evidence-note h2{margin:7px 0 0;font-size:1.05rem;color:#173a5a}.evidence-note p{margin:0;color:#6a8196;font-size:.66rem;line-height:1.5}.next-epic{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;margin-top:10px;padding:16px 19px}.next-epic span{font-size:.52rem;text-transform:uppercase;letter-spacing:.08em;color:#8397a8}.next-epic strong{font-size:.72rem;color:#244e75}.next-epic b{color:#3269b4}
  @media(max-width:980px){.epic-header,.focus-heading,.evidence-note{grid-template-columns:1fr}.epic-facts{border-left:0;border-top:1px solid rgba(18,52,85,.08)}.story-grid{grid-template-columns:1fr}.decision-table article{grid-template-columns:34px 1fr}.decision-table p{grid-column:2}.detail-intro,.detail-pair,.decision-flow-grid{grid-template-columns:1fr}.ownership-panel{grid-template-columns:1fr}.ownership-panel ul{grid-template-columns:1fr}}
  @media(max-width:700px){.product-workspace{padding-top:10px}.workspace-bar{top:70px;grid-template-columns:1fr auto}.workspace-bar>a:last-child{display:none}.workspace-key{justify-self:end}.epic-header{padding:20px}.epic-facts{grid-template-columns:1fr}.epic-facts div{border-right:0;border-bottom:1px solid rgba(18,52,85,.07)}.epic-facts div:last-child{border-bottom:0}.evidence-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.evidence-strip article{display:grid}.evidence-strip p{text-align:left}.section-label{display:block}.section-label h2{margin-top:5px}.feature-item summary{grid-template-columns:68px minmax(0,1fr) 26px}.feature-signal{grid-column:2;text-align:left}.feature-toggle{grid-column:3;grid-row:1/3}.feature-detail{padding:0 12px 14px}.detail-tabs{overflow-x:auto}.feature-evidence{grid-template-columns:1fr}.next-epic{grid-template-columns:1fr auto}.next-epic span{display:none}}
</style>

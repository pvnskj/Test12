---
import { projects, type Project, type ProjectMetric } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length]!;

const approachTags: Record<string, string[]> = {
  'rag-analysis-agent': ['Grounded', 'Permission-aware', 'Evaluation-gated', 'Traceable'],
  'build-plus': ['Data-first', 'Lifecycle', 'Validate-first', 'Traceable'],
  rfds: ['Rules-first', 'Governed data', 'Validate-first', 'Operational'],
  'gl-coding': ['Policy-led', 'Configurable', 'Validate-first', 'Audit-ready'],
  'lease-vendor-management': ['Control-first', 'Eligibility-gated', 'Lifecycle', 'Traceable'],
};

const publicText = (text: string) => text
  .replace(/Hansen/gi, 'catalog configuration')
  .replace(/Camunda/gi, 'legacy workflow engine')
  .replace(/Change Bucket/gi, 'service-change')
  .replace(/VendorOne/gi, 'vendor-management platform')
  .replace(/NexsysOne/gi, 'operations platform')
  .replace(/GitLab/gi, 'engineering repositories')
  .replace(/Jira/gi, 'work management')
  .replace(/Confluence/gi, 'knowledge base')
  .replace(/Claude via Bedrock/gi, 'private LLM runtime')
  .replace(/AWS Bedrock/gi, 'private model runtime')
  .replace(/Bedrock/gi, 'private model runtime')
  .replace(/Oracle Finance/gi, 'ERP finance')
  .replace(/Oracle IDs/gi, 'ERP identifiers')
  .replace(/Oracle/gi, 'ERP')
  .replace(/\bN1\b/g, 'operations platform')
  .replace(/\bQDS\b/g, 'engineering system')
  .replace(/\bMCP\b/g, 'live connectors')
  .replace(/FastAPI/gi, 'service API')
  .replace(/\bOMS\b/g, 'order-management platform')
  .replace(/\bWMS\b/g, 'warehouse platform')
  .replace(/\bFSLs\b/g, 'field stocking locations')
  .replace(/\bIHS\b/g, 'in-house service teams')
  .replace(/\bGCs\b/g, 'field partners')
  .replace(/\bHubs\b/g, 'distribution hubs');

const metricType = (metric: ProjectMetric) => {
  const text = `${metric.label} ${metric.detail}`.toLowerCase();
  if (text.includes('projected') || text.includes('modeled target')) return 'Projected';
  if (text.includes('estimated') || text.includes('estimate')) return 'Estimated';
  if (text.includes('measured')) return 'Measured';
  if (text.includes('actual') || text.includes('observed') || text.includes('implemented')) return 'Actual';
  return 'Evidence';
};

const partition = <T,>(items: T[], groups: number, index: number): T[] => {
  if (!items.length) return [];
  const start = Math.floor(index * items.length / groups);
  const end = Math.floor((index + 1) * items.length / groups);
  return items.slice(start, Math.max(start + 1, end));
};

const focusAreas = project.increments.map((increment, index) => ({
  code: `FOCUS-${String(index + 1).padStart(2, '0')}`,
  title: publicText(increment.title),
  purpose: publicText(increment.focus),
  learning: publicText(increment.learning),
  capabilities: increment.focus.split(',').map((item) => publicText(item.trim())).filter(Boolean),
  challenges: partition(project.complexity, project.increments.length, index).map(publicText),
  ownership: partition(project.ownership, project.increments.length, index).map(publicText),
  decisions: [project.decisions[index] ?? project.decisions[project.decisions.length - 1]!].map((item) => ({
    title: publicText(item.title),
    body: publicText(item.body),
  })),
  flow: partition(project.flow, project.increments.length, index).map(publicText),
  evidence: project.metrics[index] ?? project.metrics[project.metrics.length - 1]!,
}));

const facts = [project.metrics[1], project.metrics[2]].filter(Boolean) as ProjectMetric[];
---

<main class="product-workspace shell" data-project={project.slug}>
  <nav class="workspace-bar glass-bar" aria-label="Project navigation">
    <a href={`${base}#work`}>← Back to portfolio</a>
    <div class="workspace-key"><span>EPIC-{project.index}</span><b>Epic overview</b></div>
    <a href={`${base}work/${nextProject.slug}/`}>Next project →</a>
  </nav>

  <section class="epic-header glass-card" aria-labelledby="project-title">
    <div class="epic-main">
      <span class="category-pill">{publicText(project.category)}</span>
      <h1 id="project-title">{project.title}</h1>
      <p>{publicText(project.headline)}</p>
      <div class="approach-tags" aria-label="Product approach">
        {(approachTags[project.slug] ?? ['Outcome-first', 'Evidence-led', 'Governed', 'Scalable']).map((tag) => <span>{tag}</span>)}
      </div>
    </div>

    <aside class="epic-facts" aria-label="Epic facts">
      {facts.map((metric) => <div><small>{publicText(metric.label)}</small><strong>{metric.value}</strong><span>{metricType(metric)}</span></div>)}
      <div><small>Focus areas</small><strong>{project.increments.length}</strong><span>capability areas</span></div>
    </aside>
  </section>

  <section class="evidence-strip" aria-label="Key evidence">
    {project.metrics.map((metric) => (
      <article class="glass-card">
        <div><span>{metricType(metric)}</span><strong>{metric.value}</strong></div>
        <p>{publicText(metric.label)}</p>
      </article>
    ))}
  </section>

  <section class="overview-section" aria-labelledby="overview-title">
    <div class="section-label"><span>The big picture</span><h2 id="overview-title">Why this product had to change</h2></div>
    <p class="overview-copy">{publicText(project.summary)}</p>

    <div class="story-grid">
      <article class="glass-card">
        <span>Problem</span>
        <h3>{publicText(project.question)}</h3>
        <p>{publicText(project.problem)}</p>
      </article>
      <article class="glass-card">
        <span>Product decision</span>
        <h3>{publicText(project.decisions[0]?.title ?? 'Change the operating model')}</h3>
        <p>{publicText(project.productGoal)}</p>
      </article>
      <article class="glass-card outcome-card">
        <span>Outcome</span>
        <h3>What changed in practice</h3>
        <p>{publicText(project.valueNarrative)}</p>
      </article>
    </div>
  </section>

  <section class="decision-section" aria-labelledby="decisions-title">
    <div class="section-label"><span>Key product decisions</span><h2 id="decisions-title">Why the product moved this way</h2></div>
    <div class="decision-table glass-card">
      {project.decisions.map((decision, index) => (
        <article>
          <b>{String(index + 1).padStart(2, '0')}</b>
          <h3>{publicText(decision.title)}</h3>
          <p>{publicText(decision.body)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="focus-section" aria-labelledby="focus-title">
    <div class="focus-heading">
      <div class="section-label"><span>Focus areas</span><h2 id="focus-title">Open a capability to see the detailed case study</h2></div>
      <p>One Epic, one page. The supporting detail is distributed into the focus areas so the full story stays available without turning the page into a wall of text.</p>
    </div>

    <div class="feature-list" data-feature-list>
      {focusAreas.map((area, index) => {
        const evidence = area.evidence;
        return (
          <details class="feature-item glass-card" data-feature>
            <summary>
              <div class="feature-key"><span>{area.code}</span><b>{String(index + 1).padStart(2, '0')}</b></div>
              <div class="feature-summary-copy">
                <h3>{area.title}</h3>
                <p>{area.purpose}</p>
              </div>
              <div class="feature-signal"><strong>{evidence.value}</strong><span>{metricType(evidence)}</span></div>
              <span class="feature-toggle" aria-hidden="true">＋</span>
            </summary>

            <div class="feature-detail">
              <nav class="detail-tabs" aria-label={`${area.title} detail sections`}>
                <span>Overview</span><span>Ownership</span><span>Decisions</span><span>Evidence</span>
              </nav>

              <div class="detail-intro">
                <article>
                  <small>Why this matters</small>
                  <h4>The question this focus area had to resolve</h4>
                  <p>{area.learning}</p>
                </article>
                <article>
                  <small>Product lens</small>
                  <h4>{area.title}</h4>
                  <p>{area.purpose}</p>
                </article>
              </div>

              <div class="detail-pair">
                <article class="detail-card">
                  <small>Capabilities delivered</small>
                  <ul>{area.capabilities.map((item) => <li>{item}</li>)}</ul>
                </article>
                <article class="detail-card">
                  <small>Challenges & trade-offs</small>
                  <ul>{area.challenges.map((item) => <li>{item}</li>)}</ul>
                </article>
              </div>

              <section class="ownership-panel">
                <div><small>What I owned</small><h4>The product calls and sequencing I was accountable for.</h4></div>
                <ul>{area.ownership.map((item) => <li>{item}</li>)}</ul>
              </section>

              <div class="decision-flow-grid">
                <section class="focus-decisions">
                  <small>Product decisions</small>
                  {area.decisions.map((decision, decisionIndex) => (
                    <article><b>{String(decisionIndex + 1).padStart(2, '0')}</b><div><h4>{decision.title}</h4><p>{decision.body}</p></div></article>
                  ))}
                </section>

                <section class="system-flow">
                  <small>System flow · simplified</small>
                  <div class="flow-steps">
                    {area.flow.map((step, flowIndex) => <div class="flow-step"><b>{String(flowIndex + 1).padStart(2, '0')}</b><span>{step}</span></div>)}
                  </div>
                </section>
              </div>

              <section class="feature-evidence">
                <div><small>What the number means</small><strong>{evidence.value}</strong><h4>{publicText(evidence.label)}</h4><span>{metricType(evidence)}</span></div>
                <p>{publicText(evidence.detail)}</p>
              </section>
            </div>
          </details>
        );
      })}
    </div>
  </section>

  <section class="evidence-note glass-card" aria-labelledby="evidence-note-title">
    <div><span>Evidence discipline</span><h2 id="evidence-note-title">The number is only useful when the reader knows what it proves.</h2></div>
    <p>Measured, actual, estimated, and projected outcomes remain visibly qualified instead of being flattened into the same kind of claim.</p>
  </section>

  <a class="next-epic glass-card" href={`${base}work/${nextProject.slug}/`}><span>Next epic</span><strong>{nextProject.title}</strong><b aria-hidden="true">→</b></a>
</main>

<script>
  const featureItems = Array.from(document.querySelectorAll('[data-feature]'));
  featureItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!(item instanceof HTMLDetailsElement) || !item.open) return;
      featureItems.forEach((other) => {
        if (other !== item && other instanceof HTMLDetailsElement) other.open = false;
      });
    });
  });
</script>


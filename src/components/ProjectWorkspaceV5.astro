---
import { projects, type Project } from '../data/projects';

interface Props { project: Project; }

type StoryCopy = {
  headline: string;
  opening: string;
  ownership: string;
  approach: string;
  valueLead: string;
  demonstrates: string;
};

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const previousProject = projects[(currentIndex - 1 + projects.length) % projects.length]!;
const nextProject = projects[(currentIndex + 1) % projects.length]!;

const copyBySlug: Record<string, StoryCopy> = {
  'asset-catalog': {
    headline: 'I treated trust as a product state—not the result of submitting a form.',
    opening: 'The visible request screen was only the beginning. The harder product problem was deciding when an asset became complete enough to trust, who was accountable for that decision, how the state moved through MDM and ERP, and what the product should do when those systems disagreed.',
    ownership: 'I framed the product around the end-to-end asset lifecycle, aligned business governance with system ownership, and ordered delivery around data integrity before downstream automation. That kept the Product Goal focused on trusted enterprise data rather than feature completion.',
    approach: 'Lifecycle and state modelling made approval, synchronization, reconciliation, and hold conditions explicit. Rules-driven configuration handled frequently changing governance; exception states protected downstream systems from silent failure.',
    valueLead: 'The outcome was a governed enterprise backbone that could move asset data from request to trusted downstream availability with less rework and clearer accountability.',
    demonstrates: 'Master data · Governance · Enterprise integration · Configurable policy · Exception handling · Value delivery',
  },
  inventory: {
    headline: 'I did not force one source of truth. I defined which system was authoritative at each lifecycle state.',
    opening: 'ERP, WMS, Fixed Assets, planning, and receiving could each be correct about their own part of an asset and still fail to answer the operational question: where is it, what state is it in, and can we prove how it got there?',
    ownership: 'I defined the lifecycle model across physical and financial systems, used serialized identity as the thread connecting those states, and treated reconciliation and reverse logistics as first-class product behavior rather than operational cleanup.',
    approach: 'Domain and source-of-truth mapping mattered because authority changed over time. Sequencing began with identity and custody because automating an unreliable identity model would only scale the wrong answer.',
    valueLead: 'The product created a digital chain of custody that improved traceability, strengthened financial controls, and made high-value inventory more usable as working capital.',
    demonstrates: 'System-of-systems ownership · Lifecycle design · Reconciliation · Financial controls · Reverse logistics',
  },
  rfds: {
    headline: 'I turned engineering knowledge trapped in spreadsheets into explicit, testable product behavior.',
    opening: 'RFDS generation looked like a document-automation problem. It was actually a knowledge and data problem: planning data, procurement attributes, site context, engineering rules, and specialist judgment all had to become coherent before the output could be trusted.',
    ownership: 'I reframed the Product Goal around reducing planning-to-field risk and cycle time, translated domain rules into implementable product behavior, and kept human review where exceptions carried real engineering consequences.',
    approach: 'I separated source-data integrity, domain modelling, rules, validation, and document generation because each had a different failure mode. The decision pipeline became trustworthy before we optimized the final document.',
    valueLead: 'The result was a repeatable path from live source data to field-ready engineering output, with less manual interpretation, stronger traceability, and materially faster approvals.',
    demonstrates: 'Technical Product Ownership · Domain rules · Data integration · Human-in-the-loop automation · Operational value',
  },
  inspection: {
    headline: 'I shifted the Product Goal from completing inspections to making better intervention decisions.',
    opening: 'A maintenance program can be consistent and still waste field capacity. Fixed schedules do not account for actual usage, repeat faults are easy to miss, and predictive signals create no value unless they become the right work at the right time.',
    ownership: 'I connected asset requirements, historical faults, lifecycle state, predictive signals, work-order orchestration, and field feedback around one outcome: improve reliability while reducing unnecessary intervention.',
    approach: 'I used a maturity path rather than jumping directly to prediction. Planned maintenance established the baseline, proactive rules introduced historical evidence, and predictive signals were added where they could change a real decision without removing human accountability.',
    valueLead: 'The product moved maintenance toward risk-informed action, reducing unnecessary field effort while improving the quality and timing of intervention.',
    demonstrates: 'Outcome-based Product Ownership · Evidence-driven prioritization · Field workflow · Feedback loops · Risk-informed decisions',
  },
  'gl-coding': {
    headline: 'I separated changing accounting policy from the software responsible for enforcing it.',
    opening: 'The original coding logic worked for a narrow project portfolio. As new project types and mixed CapEx/OpEx activity appeared, hard-coded rules became both a delivery bottleneck and a financial-control risk.',
    ownership: 'I reframed the problem from generating a code string to managing policy safely at scale, decomposed the financial code into governed components, and created controls around simulation, review, posting, and audit evidence.',
    approach: 'Rules-driven product design fit because accounting policy changed more frequently than the application architecture should. Configurable lookup tables created agility, while reviewer gates and traceability preserved control where the cost of a wrong decision was high.',
    valueLead: 'The product reduced manual coding and rework while making policy changes easier to govern and financial decisions easier to trace.',
    demonstrates: 'Configurable policy · Financial controls · Rules engines · Auditability · Product scalability',
  },
  'order-fulfillment': {
    headline: 'I modelled the customer promise across systems that each owned only part of the order.',
    opening: project.problem,
    ownership: 'I defined the shared order lifecycle, preserved specialized system boundaries, and made backlog and exception states visible product behavior rather than spreadsheet operations.',
    approach: 'A hub-and-spoke orchestration model kept WMS, TMS, ERP, and planning responsible for specialized execution while the product made their combined state coherent for operations and customers.',
    valueLead: 'The operating model is supported by the source material; quantitative claims remain withheld because the current impact material is explicitly labelled as placeholder content.',
    demonstrates: 'Customer outcome · Cross-system orchestration · Lifecycle state · Exceptions · Operational visibility',
  },
  'financial-projections': {
    headline: 'I treated model quality, scale, security, and cloud cost as product constraints—not backend details.',
    opening: project.problem,
    ownership: 'I shaped the product boundary around independently changing capabilities, dependable API access, security, scenario management, and cost-aware scaling so model evolution would not destabilize the whole platform.',
    approach: 'Service boundaries were chosen by reason to change, while scenario variance and cost signals were treated as product evidence. Technical architecture stayed connected to decision quality and operating economics.',
    valueLead: project.valueNarrative,
    demonstrates: 'Platform Product Ownership · API products · Model evolution · Security · Scalability · FinOps',
  },
};

const copy = copyBySlug[project.slug] ?? {
  headline: project.headline,
  opening: project.problem,
  ownership: project.ownership.join(' '),
  approach: project.summary,
  valueLead: project.valueNarrative,
  demonstrates: project.category,
};

const stages = [
  ['overview', '01 · Overview'],
  ['model', '02 · Product model'],
  ['decisions', '03 · Decisions'],
  ['value', '04 · Value'],
] as const;
---

<div class="v5-workspace shell" data-project-workspace>
  <aside class="v5-project-rail glass-card" aria-label="Selected product initiatives">
    <div class="v5-project-rail-head">
      <span class="eyebrow">Selected product portfolio</span>
      <strong>Representative initiatives from a broader body of work.</strong>
      <small>Switch projects without returning to the homepage.</small>
    </div>
    <nav>
      {projects.map((item) => (
        <a class:list={['v5-project-link', { 'is-current': item.slug === project.slug }]} href={`${base}work/${item.slug}/`} aria-current={item.slug === project.slug ? 'page' : undefined}>
          <span>{item.index}</span><div><strong>{item.title}</strong><small>{item.eyebrow}</small></div>
        </a>
      ))}
    </nav>
  </aside>

  <main class="v5-project-canvas" transition:animate="fade">
    <div class="v5-mobile-project-switcher glass-bar">
      <details>
        <summary><span>{project.index}</span><strong>{project.title}</strong><i aria-hidden="true">⌄</i></summary>
        <nav aria-label="Switch project">
          {projects.map((item) => <a href={`${base}work/${item.slug}/`} aria-current={item.slug === project.slug ? 'page' : undefined}><span>{item.index}</span><strong>{item.title}</strong></a>)}
        </nav>
      </details>
    </div>

    <header class="v5-project-hero">
      <div class="v5-project-meta"><a href={`${base}#work`} class="v5-back-link">← Selected work</a><span>{project.category}</span></div>
      <p class="eyebrow">{project.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p class="v5-hero-lede">{copy.opening}</p>
      <div class="v5-goal-line glass-card"><span>Product Goal</span><strong>{project.productGoal}</strong></div>
      {project.metrics.length > 0 && <div class="v5-hero-evidence" aria-label="Selected evidence">{project.metrics.slice(0, 3).map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>}
    </header>

    <nav class="v5-story-tabs glass-bar" role="tablist" aria-label={`${project.title} story views`}>
      {stages.map(([id, label], index) => <a id={`tab-${id}`} href={`#${id}`} role="tab" aria-controls={`panel-${id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-story-tab={id}>{label}</a>)}
    </nav>

    <div class="v5-story-deck">
      <section id="panel-overview" class="v5-story-stage is-active" role="tabpanel" aria-labelledby="tab-overview" data-story-panel="overview">
        <div class="v5-stage-heading"><span>What I was solving</span><h2>The product problem was larger than the visible workflow.</h2></div>
        <div class="v5-overview-grid">
          <article class="glass-card v5-overview-card"><span>Problem</span><p>{project.problem}</p></article>
          <article class="glass-card v5-overview-card is-accent"><span>My Product Ownership focus</span><p>{copy.ownership}</p></article>
          <article class="glass-card v5-overview-card"><span>Why this approach</span><p>{copy.approach}</p></article>
        </div>
      </section>

      <section id="panel-model" class="v5-story-stage" role="tabpanel" aria-labelledby="tab-model" data-story-panel="model">
        <div class="v5-stage-heading"><span>Primary infographic</span><h2>Make the complexity understandable in one scan.</h2><p>{project.flowCaption}</p></div>

        {project.slug === 'asset-catalog' && <div class="v5-infographic v5-asset-model glass-card" role="img" aria-label="Asset trust lifecycle from request through reconciliation">{project.flow.map((step, index) => <div class="v5-info-node"><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong>{index < project.flow.length - 1 && <i aria-hidden="true">→</i>}</div>)}<aside><strong>Trust boundary</strong><span>Approval is not the end state. Reconciliation determines whether the asset is safe to publish.</span></aside></div>}

        {project.slug === 'inventory' && <div class="v5-infographic v5-inventory-model glass-card" role="img" aria-label="Serialized asset connected to systems that own different lifecycle states"><div class="v5-inventory-core"><span>Persistent identity</span><strong>Serialized asset</strong><small>one lifecycle thread</small></div><div class="v5-system-node n1"><strong>ERP</strong><small>procurement · finance</small></div><div class="v5-system-node n2"><strong>WMS</strong><small>warehouse custody</small></div><div class="v5-system-node n3"><strong>Fixed Assets</strong><small>capitalization</small></div><div class="v5-system-node n4"><strong>Planning</strong><small>demand · usage</small></div><div class="v5-system-node n5"><strong>Receiving</strong><small>physical truth</small></div><div class="v5-custody-strip"><span>Receive</span><i>→</i><span>Identify</span><i>→</i><span>Move</span><i>→</i><span>Deploy</span><i>→</i><span>Recover</span></div></div>}

        {project.slug === 'rfds' && <div class="v5-infographic v5-rfds-model glass-card" role="img" aria-label="RFDS knowledge pipeline from source data to field-ready output"><div class="v5-rfds-sources"><div><strong>RF planning</strong><small>site · sector · frequency</small></div><div><strong>Procurement catalog</strong><small>approved equipment · attributes</small></div></div><i>↓</i><div class="v5-rfds-stage"><span>Normalized site model</span><small>trusted context</small></div><i>↓</i><div class="v5-rfds-rules"><strong>Rules engine</strong><div><span>sector</span><span>placement</span><span>frequency</span><span>cable</span></div></div><i>↓</i><div class="v5-rfds-split"><div><strong>Known condition</strong><small>automate</small></div><div><strong>Exception</strong><small>specialist review</small></div></div><i>↓</i><div class="v5-rfds-output"><strong>RFDS + diagrams</strong><small>field-ready · traceable</small></div></div>}

        {project.slug === 'inspection' && <div class="v5-infographic v5-inspection-model glass-card" role="img" aria-label="Maintenance maturity and intervention decision loop"><div class="v5-maturity-row"><div><span>01</span><strong>Planned</strong><small>schedule</small></div><i>→</i><div><span>02</span><strong>Proactive</strong><small>history</small></div><i>→</i><div class="is-accent"><span>03</span><strong>Predictive</strong><small>forecast</small></div></div><div class="v5-inspection-inputs"><span>asset requirements</span><span>usage & faults</span><span>lifecycle context</span></div><i>↓</i><div class="v5-intervention"><strong>Intervention decision</strong><small>risk · urgency · work-window · human review</small></div><i>↓</i><div class="v5-field-loop"><span>Work order</span><i>→</i><span>Field result</span><i>→</i><span>Evidence</span><i>↺</i></div></div>}

        {project.slug === 'gl-coding' && <div class="v5-infographic v5-gl-model glass-card" role="img" aria-label="Dynamic GL coding policy abstraction"><div class="v5-gl-context"><span>project type</span><span>entity</span><span>activity</span><span>spend</span><span>asset context</span></div><i>↓</i><div class="v5-gl-policy"><strong>Configurable policy layer</strong><small>lookup tables · mapping rules · exceptions</small></div><i>↓</i><div class="v5-gl-controls"><span>simulate</span><i>→</i><span>review</span><i>→</i><span>validate</span><i>→</i><span>post</span></div><div class="v5-gl-result"><strong>Auditable GL code</strong><small>policy can change without rewriting the product architecture</small></div></div>}

        {project.slug === 'order-fulfillment' && <div class="v5-infographic v5-order-model glass-card" role="img" aria-label="Order platform coordinating planning WMS TMS and ERP"><div class="v5-order-core"><span>System of engagement</span><strong>Order platform</strong><small>shared customer promise</small></div><div class="v5-order-node o1"><strong>Planning</strong><small>demand · backlog</small></div><div class="v5-order-node o2"><strong>WMS</strong><small>pick · ship</small></div><div class="v5-order-node o3"><strong>TMS</strong><small>transit · delivery</small></div><div class="v5-order-node o4"><strong>ERP</strong><small>financial state</small></div><div class="v5-order-strip"><span>order</span><i>→</i><span>allocate</span><i>→</i><span>fulfill</span><i>→</i><span>deliver</span><i>→</i><span>reconcile</span></div></div>}

        {project.slug === 'financial-projections' && <div class="v5-infographic v5-financial-model glass-card" role="img" aria-label="Financial projection platform service and product trade-off model"><div class="v5-financial-client"><strong>Consumers / scenarios</strong><small>decision-support needs</small></div><i>↓</i><div class="v5-financial-gateway"><strong>API gateway</strong><small>identity · routing · rate limits</small></div><i>↓</i><div class="v5-financial-services"><div><strong>Data aggregation</strong></div><div><strong>Projection engine</strong></div><div><strong>Recommendation service</strong></div></div><div class="v5-financial-constraints"><span>security</span><span>model quality</span><span>scale</span><span>cloud cost</span></div></div>}
      </section>

      <section id="panel-decisions" class="v5-story-stage" role="tabpanel" aria-labelledby="tab-decisions" data-story-panel="decisions">
        <div class="v5-stage-heading"><span>Product judgment</span><h2>The decisions are the story.</h2><p>These choices shaped the product boundary, risk profile, or the order in which value could be delivered.</p></div>
        <div class="v5-decision-grid">{project.decisions.map((decision, index) => <article class="glass-card"><span>0{index + 1}</span><h3>{decision.title}</h3><p>{decision.body}</p></article>)}</div>
        <details class="v5-deep-dive glass-card">
          <summary><span>Explore the deeper product reasoning</span><i aria-hidden="true">+</i></summary>
          <div class="v5-deep-dive-content">
            <section><h3>How I ordered delivery</h3><div class="v5-increment-list">{project.increments.map((increment, index) => <article><span>0{index + 1}</span><div><strong>{increment.title}</strong><p>{increment.focus}</p><small>{increment.learning}</small></div></article>)}</div></section>
            <section><h3>What made this hard</h3><ul>{project.complexity.map((item) => <li>{item}</li>)}</ul></section>
          </div>
        </details>
      </section>

      <section id="panel-value" class="v5-story-stage" role="tabpanel" aria-labelledby="tab-value" data-story-panel="value">
        <div class="v5-stage-heading"><span>Business value & evidence</span><h2>Shipping mattered only if the operating outcome moved.</h2><p>{copy.valueLead}</p></div>
        {project.metrics.length > 0 ? <div class="v5-value-band glass-card">{project.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span><small>{metric.detail}</small></div>)}</div> : <div class="v5-evidence-note glass-card"><strong>Evidence discipline</strong><p>Quantitative claims are intentionally withheld until the underlying impact material is validated.</p></div>}
        <div class="v5-outcome-line glass-card"><span>What this demonstrates</span><strong>{copy.demonstrates}</strong></div>
        <div class="v5-feedback-loop" aria-label="Increment evidence adaptation loop"><span>Increment</span><i>→</i><span>Observe</span><i>→</i><span>Inspect</span><i>→</i><span>Adapt Product Backlog</span></div>
      </section>
    </div>

    <footer class="v5-project-footer"><a href={`${base}work/${previousProject.slug}/`}><span>← Previous</span><strong>{previousProject.title}</strong></a><a href={`${base}work/${nextProject.slug}/`}><span>Next →</span><strong>{nextProject.title}</strong></a></footer>
  </main>
</div>

<script>
  const setupProjectWorkspace = () => {
    document.querySelectorAll('[data-project-workspace]').forEach((workspace) => {
      if (!(workspace instanceof HTMLElement) || workspace.dataset.enhanced === 'true') return;
      workspace.dataset.enhanced = 'true';
      const tabs = Array.from(workspace.querySelectorAll('[data-story-tab]'));
      const panels = Array.from(workspace.querySelectorAll('[data-story-panel]'));

      const activate = (id: string, updateHash = true) => {
        tabs.forEach((tab) => {
          if (!(tab instanceof HTMLElement)) return;
          const active = tab.dataset.storyTab === id;
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          const active = panel.dataset.storyPanel === id;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
        if (updateHash && window.history?.replaceState) window.history.replaceState(null, '', `#${id}`);
      };

      const initial = window.location.hash.replace('#', '');
      const validInitial = tabs.some((tab) => tab instanceof HTMLElement && tab.dataset.storyTab === initial);
      activate(validInitial ? initial : 'overview', false);

      tabs.forEach((tab, index) => {
        if (!(tab instanceof HTMLAnchorElement)) return;
        tab.addEventListener('click', (event) => { event.preventDefault(); activate(tab.dataset.storyTab || 'overview'); });
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let target = index;
          if (event.key === 'ArrowRight') target = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft') target = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') target = 0;
          if (event.key === 'End') target = tabs.length - 1;
          const next = tabs[target];
          if (next instanceof HTMLElement) { activate(next.dataset.storyTab || 'overview'); next.focus(); }
        });
      });
    });
  };

  document.addEventListener('astro:page-load', setupProjectWorkspace);
  if (document.readyState !== 'loading') setupProjectWorkspace();
</script>

---
import { projects } from '../data/projects';
import { eomDecisions, eomEpic, eomFocusAreas, eomMetrics } from '../data/eomCase';

const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === 'enterprise-order-management');
const nextProject = projects[(currentIndex + 1) % projects.length]!;
---

<main class="eom-workspace shell">
  <nav class="workspace-bar glass-bar" aria-label="Project navigation">
    <a href={`${base}#work`}>← Back to portfolio</a>
    <div class="workspace-key"><span>{eomEpic.code}</span><b>Epic overview</b></div>
    <a href={`${base}work/${nextProject.slug}/`}>Next project →</a>
  </nav>

  <section class="epic-header glass-card" aria-labelledby="eom-title">
    <div class="epic-main">
      <span class="category-pill">{eomEpic.category}</span>
      <h1 id="eom-title">{eomEpic.title}</h1>
      <p>{eomEpic.headline}</p>
      <div class="approach-tags" aria-label="Product approach">
        <span>Dependency-first</span>
        <span>Configurable</span>
        <span>Governed context</span>
        <span>Evidence-led</span>
      </div>
    </div>

    <aside class="epic-facts" aria-label="Epic facts">
      <div><small>Product scope</small><strong>18</strong><span>service intents</span></div>
      <div><small>Coordination</small><strong>19+</strong><span>teams</span></div>
      <div><small>Operating model</small><strong>Dynamic</strong><span>dependency-driven</span></div>
    </aside>
  </section>

  <section class="evidence-strip" aria-label="Key evidence">
    {eomMetrics.map((metric) => (
      <article class="glass-card">
        <div><span>{metric.type}</span><strong>{metric.value}</strong></div>
        <p>{metric.label}</p>
      </article>
    ))}
  </section>

  <section class="overview-section" aria-labelledby="overview-title">
    <div class="section-label"><span>The big picture</span><h2 id="overview-title">Why this product had to change</h2></div>
    <p class="overview-copy">{eomEpic.bigPicture}</p>

    <div class="story-grid">
      <article class="glass-card">
        <span>Problem</span>
        <h3>Product change had become workflow change.</h3>
        <p>{eomEpic.problem}</p>
      </article>
      <article class="glass-card">
        <span>Product decision</span>
        <h3>Describe dependencies instead of every path.</h3>
        <p>{eomEpic.decision}</p>
      </article>
      <article class="glass-card outcome-card">
        <span>Outcome</span>
        <h3>Build a reusable orchestration platform.</h3>
        <p>{eomEpic.outcome}</p>
      </article>
    </div>
  </section>

  <section class="decision-section" aria-labelledby="decisions-title">
    <div class="section-label"><span>Key product decisions</span><h2 id="decisions-title">Why the product moved this way</h2></div>
    <div class="decision-table glass-card">
      {eomDecisions.map((decision, index) => (
        <article>
          <b>{String(index + 1).padStart(2, '0')}</b>
          <h3>{decision.title}</h3>
          <p>{decision.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="focus-section" aria-labelledby="focus-title">
    <div class="focus-heading">
      <div class="section-label"><span>Focus areas</span><h2 id="focus-title">Open a capability to see the detailed case study</h2></div>
      <p>One Epic, one page. Each focus area expands here with the ownership, complexity, decisions, trade-offs, system flow, learning, and evidence behind it.</p>
    </div>

    <div class="feature-list" data-feature-list>
      {eomFocusAreas.map((area, index) => {
        const evidence = area.evidence[0];
        return (
          <details class="feature-item glass-card" data-feature>
            <summary>
              <div class="feature-key"><span>{area.code}</span><b>{String(index + 1).padStart(2, '0')}</b></div>
              <div class="feature-summary-copy">
                <h3>{area.title}</h3>
                <p>{area.purpose}</p>
              </div>
              <div class="feature-signal">
                {evidence && <><strong>{evidence.value}</strong><span>{evidence.type}</span></>}
              </div>
              <span class="feature-toggle" aria-hidden="true">＋</span>
            </summary>

            <div class="feature-detail">
              <nav class="detail-tabs" aria-label={`${area.title} detail sections`}>
                <span>Overview</span><span>Ownership</span><span>Decisions</span><span>Evidence</span>
              </nav>

              <div class="detail-intro">
                <article>
                  <small>Why this matters</small>
                  <h4>The product problem behind this focus area</h4>
                  <p>{area.whyItMatters}</p>
                </article>
                <article>
                  <small>Product lens</small>
                  <h4>{area.shortTitle}</h4>
                  <p>{area.learning}</p>
                </article>
              </div>

              <div class="detail-pair">
                <article class="detail-card">
                  <small>Capabilities delivered</small>
                  <ul>{area.capabilities.map((item) => <li>{item}</li>)}</ul>
                </article>
                <article class="detail-card">
                  <small>Challenges & trade-offs</small>
                  <ul>{area.challenges.map((item) => <li>{item}</li>)}</ul>
                </article>
              </div>

              <section class="ownership-panel">
                <div><small>What I owned</small><h4>Product ownership showed up in the choices, not the ceremony.</h4></div>
                <ul>{area.ownership.map((item) => <li>{item}</li>)}</ul>
              </section>

              <div class="decision-flow-grid">
                <section class="focus-decisions">
                  <small>Product decisions</small>
                  {area.decisions.map((decision, decisionIndex) => (
                    <article>
                      <b>{String(decisionIndex + 1).padStart(2, '0')}</b>
                      <div><h4>{decision.title}</h4><p>{decision.body}</p></div>
                    </article>
                  ))}
                </section>

                <section class="system-flow">
                  <small>System flow · simplified</small>
                  <div class="flow-steps">
                    {area.flow.map((step, flowIndex) => (
                      <div class="flow-step"><b>{String(flowIndex + 1).padStart(2, '0')}</b><span>{step}</span></div>
                    ))}
                  </div>
                </section>
              </div>

              <section class="feature-evidence">
                <div>
                  <small>What the number means</small>
                  {evidence && <><strong>{evidence.value}</strong><h4>{evidence.label}</h4><span>{evidence.type}</span></>}
                </div>
                {evidence && <p>{evidence.detail}</p>}
              </section>
            </div>
          </details>
        );
      })}
    </div>
  </section>

  <section class="evidence-note glass-card" aria-labelledby="evidence-note-title">
    <div><span>Evidence discipline</span><h2 id="evidence-note-title">Measured, actual, and projected are not interchangeable.</h2></div>
    <p>The portfolio keeps those labels visible so a reader can tell what was observed, what represented delivery scope, and what remained a modeled architecture target.</p>
  </section>

  <a class="next-epic glass-card" href={`${base}work/${nextProject.slug}/`}>
    <span>Next epic</span><strong>{nextProject.title}</strong><b aria-hidden="true">→</b>
  </a>
</main>

<script>
  const featureItems = Array.from(document.querySelectorAll('[data-feature]'));
  featureItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!(item instanceof HTMLDetailsElement) || !item.open) return;
      featureItems.forEach((other) => {
        if (other !== item && other instanceof HTMLDetailsElement) other.open = false;
      });
    });
  });
</script>

<style>
  .eom-workspace{padding:18px 0 68px;color:#102f50}
  .workspace-bar{position:sticky;top:92px;z-index:40;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;min-height:52px;margin-bottom:16px;padding:7px 11px}
  .workspace-bar>a{padding:8px 10px;font-size:.68rem;font-weight:760;color:#5c7690}.workspace-bar>a:last-child{justify-self:end}
  .workspace-key{display:flex;align-items:center;gap:8px}.workspace-key span{font-size:.61rem;font-weight:850;letter-spacing:.08em;color:#3266ad}.workspace-key b{font-size:.62rem;color:#7890a6}

  .epic-header{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.55fr);gap:24px;padding:28px}
  .category-pill{display:inline-flex;padding:6px 9px;border-radius:999px;background:rgba(234,240,255,.9);font-size:.56rem;font-weight:850;letter-spacing:.055em;color:#4a67b0}
  .epic-main h1{margin:12px 0 9px;font-size:clamp(2.25rem,4.2vw,3.65rem);line-height:1;letter-spacing:-.045em;color:#123455}
  .epic-main>p{max-width:780px;margin:0;color:#617991;font-size:.87rem;line-height:1.58}
  .approach-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:17px}.approach-tags span{padding:5px 8px;border:1px solid rgba(48,99,176,.1);border-radius:999px;background:rgba(248,251,255,.76);font-size:.54rem;font-weight:780;color:#59738e}
  .epic-facts{display:grid;grid-template-columns:repeat(3,1fr);align-self:stretch;border-left:1px solid rgba(18,52,85,.08)}.epic-facts div{display:flex;flex-direction:column;justify-content:center;padding:12px 16px;border-right:1px solid rgba(18,52,85,.07)}.epic-facts div:last-child{border-right:0}.epic-facts small{font-size:.51rem;font-weight:820;text-transform:uppercase;letter-spacing:.08em;color:#8497aa}.epic-facts strong{margin:5px 0 2px;font-size:1.05rem;color:#245d9d}.epic-facts span{font-size:.57rem;line-height:1.35;color:#6f859a}

  .evidence-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:10px}.evidence-strip article{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 17px}.evidence-strip article>div{display:grid}.evidence-strip span{font-size:.49rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em;color:#8296a8}.evidence-strip strong{font-size:1.28rem;color:#1f62bf}.evidence-strip p{max-width:120px;margin:0;text-align:right;font-size:.61rem;line-height:1.35;color:#647d94}

  .overview-section,.decision-section,.focus-section{padding-top:40px}.section-label{display:flex;align-items:baseline;gap:14px;margin-bottom:14px}.section-label>span,.focus-heading>.section-label>span,.evidence-note span{font-size:.55rem;font-weight:850;text-transform:uppercase;letter-spacing:.09em;color:#7890a7}.section-label h2{margin:0;font-size:1.45rem;letter-spacing:-.025em;color:#173a5a}
  .overview-copy{max-width:1120px;margin:0 0 16px;color:#627b91;font-size:.79rem;line-height:1.65}
  .story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.story-grid article{padding:19px;min-height:170px}.story-grid article>span{font-size:.52rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em;color:#7890a7}.story-grid h3{margin:10px 0 7px;font-size:.94rem;line-height:1.25;color:#173a5b}.story-grid p{margin:0;color:#687f94;font-size:.69rem;line-height:1.55}.outcome-card{background:linear-gradient(145deg,rgba(244,250,255,.9),rgba(255,255,255,.77))}

  .decision-table{overflow:hidden;padding:0}.decision-table article{display:grid;grid-template-columns:38px minmax(200px,.42fr) minmax(0,1fr);gap:14px;align-items:center;padding:15px 18px;border-bottom:1px solid rgba(18,52,85,.07)}.decision-table article:last-child{border-bottom:0}.decision-table b{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:rgba(230,239,255,.92);font-size:.55rem;color:#3266b5}.decision-table h3{margin:0;font-size:.76rem;color:#183b5b}.decision-table p{margin:0;color:#697f94;font-size:.66rem;line-height:1.47}

  .focus-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.65fr);gap:30px;align-items:end;margin-bottom:14px}.focus-heading .section-label{margin:0}.focus-heading>p{margin:0;color:#6b8297;font-size:.68rem;line-height:1.5}
  .feature-list{display:grid;gap:8px}.feature-item{overflow:hidden;padding:0}.feature-item summary{display:grid;grid-template-columns:92px minmax(0,1fr) 105px 28px;gap:14px;align-items:center;padding:16px 18px;cursor:pointer;list-style:none}.feature-item summary::-webkit-details-marker{display:none}.feature-item[open]{border-color:rgba(46,100,185,.22);box-shadow:0 22px 55px rgba(40,72,115,.10)}
  .feature-key{display:flex;align-items:center;gap:9px}.feature-key span{font-size:.54rem;font-weight:850;color:#3264ad}.feature-key b{display:grid;place-items:center;width:24px;height:24px;border-radius:7px;background:rgba(232,240,255,.92);font-size:.53rem;color:#4d72ad}.feature-summary-copy h3{margin:0 0 3px;font-size:.83rem;color:#163858}.feature-summary-copy p{margin:0;color:#6d8397;font-size:.63rem;line-height:1.4}.feature-signal{text-align:right}.feature-signal strong{display:block;font-size:.9rem;color:#2162bd}.feature-signal span{font-size:.48rem;text-transform:uppercase;letter-spacing:.07em;color:#8295a7}.feature-toggle{display:grid;place-items:center;font-size:1rem;color:#64809a;transition:transform .2s ease}.feature-item[open] .feature-toggle{transform:rotate(45deg)}

  .feature-detail{padding:0 18px 20px;border-top:1px solid rgba(18,52,85,.07);background:linear-gradient(180deg,rgba(247,250,255,.45),rgba(255,255,255,.15))}.detail-tabs{display:flex;gap:2px;margin:0 -18px 18px;padding:7px 18px;border-bottom:1px solid rgba(18,52,85,.07);background:rgba(248,251,255,.55)}.detail-tabs span{padding:6px 10px;border-radius:7px;font-size:.55rem;font-weight:750;color:#627d97}.detail-tabs span:first-child{background:#2d67b7;color:#fff}
  .detail-intro{display:grid;grid-template-columns:1.2fr .8fr;gap:10px;margin-bottom:10px}.detail-intro article,.detail-card,.ownership-panel,.focus-decisions,.system-flow,.feature-evidence{border:1px solid rgba(18,52,85,.075);border-radius:14px;background:rgba(255,255,255,.64)}.detail-intro article{padding:16px}.feature-detail small{display:block;font-size:.5rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em;color:#8094a8}.detail-intro h4,.ownership-panel h4,.focus-decisions h4,.feature-evidence h4{margin:7px 0 5px;font-size:.76rem;color:#173a59}.detail-intro p,.focus-decisions p,.feature-evidence p{margin:0;color:#6c8296;font-size:.64rem;line-height:1.52}
  .detail-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}.detail-card{padding:16px}.detail-card ul,.ownership-panel ul{margin:10px 0 0;padding:0;list-style:none;display:grid;gap:6px}.detail-card li,.ownership-panel li{position:relative;padding-left:14px;color:#657d92;font-size:.62rem;line-height:1.4}.detail-card li:before,.ownership-panel li:before{content:'✓';position:absolute;left:0;top:0;color:#2f6db5;font-size:.56rem}
  .ownership-panel{display:grid;grid-template-columns:minmax(220px,.55fr) minmax(0,1fr);gap:20px;padding:16px;margin-bottom:10px}.ownership-panel ul{grid-template-columns:repeat(2,minmax(0,1fr));margin:0}
  .decision-flow-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}.focus-decisions,.system-flow{padding:16px}.focus-decisions>article{display:grid;grid-template-columns:28px 1fr;gap:9px;padding:11px 0;border-bottom:1px solid rgba(18,52,85,.06)}.focus-decisions>article:last-child{border-bottom:0}.focus-decisions>article>b{display:grid;place-items:center;width:24px;height:24px;border-radius:7px;background:rgba(232,240,255,.85);font-size:.5rem;color:#3569af}.focus-decisions h4{margin:0 0 3px}
  .flow-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:6px;margin-top:12px}.flow-step{position:relative;display:grid;gap:4px;align-content:start;min-height:70px;padding:9px;border-radius:10px;background:rgba(245,249,255,.88)}.flow-step:not(:last-child):after{content:'→';position:absolute;right:-8px;top:26px;z-index:2;color:#91a4b5}.flow-step b{font-size:.48rem;color:#3d6db1}.flow-step span{font-size:.54rem;line-height:1.3;color:#607a91}
  .feature-evidence{display:grid;grid-template-columns:190px 1fr;gap:18px;align-items:center;padding:16px}.feature-evidence>div>strong{display:block;margin-top:6px;font-size:1.35rem;color:#2161bc}.feature-evidence>div>span{font-size:.49rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#7890a6}

  .evidence-note{display:grid;grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr);gap:30px;align-items:center;margin-top:40px;padding:20px}.evidence-note h2{margin:7px 0 0;font-size:1.08rem;line-height:1.25;color:#173957}.evidence-note p{margin:0;color:#6a8196;font-size:.68rem;line-height:1.55}
  .next-epic{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;margin-top:10px;padding:15px 18px;text-decoration:none}.next-epic span{font-size:.52rem;text-transform:uppercase;letter-spacing:.08em;color:#8295a6}.next-epic strong{font-size:.72rem;color:#244d73}.next-epic b{color:#376db3}

  @media(max-width:960px){.epic-header{grid-template-columns:1fr}.epic-facts{border-left:0;border-top:1px solid rgba(18,52,85,.08)}.focus-heading,.detail-intro,.ownership-panel,.decision-flow-grid,.evidence-note{grid-template-columns:1fr}.ownership-panel ul{grid-template-columns:1fr}.story-grid{grid-template-columns:1fr}.decision-table article{grid-template-columns:38px minmax(180px,.45fr) 1fr}}
  @media(max-width:680px){.eom-workspace{padding-top:10px}.workspace-bar{top:70px;grid-template-columns:1fr auto}.workspace-bar>a:last-child{display:none}.epic-header{padding:20px}.epic-main h1{font-size:2.25rem}.epic-facts{grid-template-columns:1fr 1fr}.epic-facts div:last-child{grid-column:1/-1;border-top:1px solid rgba(18,52,85,.07)}.evidence-strip{grid-template-columns:1fr 1fr}.evidence-strip article{display:block}.evidence-strip p{text-align:left;margin-top:3px}.section-label{display:grid;gap:4px}.section-label h2{font-size:1.18rem}.decision-table article{grid-template-columns:32px 1fr}.decision-table p{grid-column:2}.focus-heading{grid-template-columns:1fr;gap:7px}.feature-item summary{grid-template-columns:72px 1fr 28px}.feature-signal{display:none}.feature-summary-copy p{display:none}.detail-tabs{overflow-x:auto}.detail-pair{grid-template-columns:1fr}.flow-steps{grid-template-columns:1fr}.flow-step:not(:last-child):after{content:'↓';right:50%;top:auto;bottom:-10px}.feature-evidence{grid-template-columns:1fr}.next-epic{grid-template-columns:1fr auto}.next-epic span{display:none}}
</style>

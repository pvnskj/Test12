---
import type { Project } from '../data/projects';
import SystemGlyph from './SystemGlyph.astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class:list={['project-card', 'glass-card', featured && 'project-card--featured']} data-reveal>
  <div class="project-card-top">
    <div>
      <span class="project-index">{project.index}</span>
      <span class="eyebrow">{project.category}</span>
    </div>
  </div>

  <div class="project-card-copy">
    <p class="project-question">{project.question}</p>
    <h3>{project.title}</h3>
    <p>{project.headline}</p>
  </div>

  <SystemGlyph variant={project.visual} label={`${project.title} system graphic`} compact={!featured} />

  <div class="project-card-goal">
    <span>Product goal</span>
    <strong>{project.productGoal}</strong>
  </div>

  <a class="text-link" href={`${base}work/${project.slug}/`}>
    Read the product story
    <span aria-hidden="true">→</span>
  </a>
</article>

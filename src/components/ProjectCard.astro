---
import type { Project } from '../data/projects';
import SystemGlyph from './SystemGlyph.astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class:list={['project-card', 'glass-card', featured && 'project-card--featured']} data-reveal>
  <div class="project-card-top">
    <div>
      <span class="project-index">{project.index}</span>
      <span class="eyebrow">{project.category}</span>
    </div>
    <span class:list={['source-status', project.sourceStatus === 'review' && 'source-status--review']}>
      {project.sourceStatus === 'review' ? 'Source review' : 'Source-backed'}
    </span>
  </div>

  <div class="project-card-copy">
    <h3>{project.title}</h3>
    <p>{project.headline}</p>
  </div>

  <SystemGlyph variant={project.visual} label={`${project.title} system graphic`} compact={!featured} />

  <div class="project-tags" aria-label={`${project.title} themes`}>
    {project.tags.slice(0, featured ? 4 : 3).map((tag) => <span>{tag}</span>)}
  </div>

  <a class="text-link" href={`${base}work/${project.slug}/`}>
    View case study
    <span aria-hidden="true">→</span>
  </a>
</article>

---
import { projects, type Project } from '../data/projects';

interface Props { project: Project; }

type Brief = {
  tagline: string;
  goal: string;
  decisions: string[];
  sequence: string[];
  proof: { value: string; label: string }[];
  depth: string[];
};

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const previousProject = projects[(currentIndex - 1 + projects.length) % projects.length]!;
const nextProject = projects[(currentIndex + 1) % projects.length]!;

const briefs: Record<string, Brief> = {
  'enterprise-order-management': {
    tagline: 'Move from manually modeled BPMN paths to declarative, dependency-driven orchestration.',
    goal: 'Launch and change subscriber services without redrawing every fulfillment path.',
    decisions: ['Dependencies over diagrams', 'Assessment before execution', 'One canonical order context', 'Policy toward configuration'],
    sequence: ['Orchestration model', 'Catalog decomposition', 'Order context', 'Scale & observability'],
    proof: [
      { value: '20%', label: 'Measured mapping-time improvement' },
      { value: '75K/day', label: 'Projected order capacity' },
      { value: '19+', label: 'Teams coordinated' },
    ],
    depth: ['Workers declare dependencies and the engine resolves the executable DAG', 'Phase 1 enriches and validates state before Phase 2 execution begins', 'Kafka push orchestration accepts greater offset-management complexity in exchange for target-scale throughput'],
  },
  'rag-analysis-agent': {
    tagline: 'Turn fragmented engineering evidence into grounded operational intelligence.',
    goal: 'Reduce technical investigation time without trading away source traceability or access control.',
    decisions: ['Accuracy over response speed', 'Live sources over static uploads', 'Evaluation as a release gate', 'Safe index refresh'],
    sequence: ['POC', 'Pilot', 'Live integrations', 'Evaluation loop'],
    proof: [
      { value: '~6 days → ~2 hrs', label: 'Measured analysis cycle' },
      { value: '11GB+', label: 'Production corpus' },
      { value: '558+', label: 'OM projects searchable' },
    ],
    depth: ['Hybrid retrieval combines semantic search with project, branch, and technical metadata', 'Every material answer is grounded in retrievable evidence and the agent explicitly abstains when support is insufficient', 'The 25+ case golden suite requires 100% groundedness and 90%+ recall before retrieval changes are promoted'],
  },
  'build-plus': {
    tagline: 'Connect trusted part data, demand, fulfillment, custody, and recovery into one operating model.',
    goal: 'Create a cradle-to-grave supply-chain lifecycle built on governed identity and upstream validation.',
    decisions: ['Data anchor first', 'Demand from evidence', 'Validate before fulfillment', 'Preserve identity end to end'],
    sequence: ['Master data', 'Predictive planning', 'Systemized fulfillment', 'Lifecycle closure'],
    proof: [
      { value: '50%+', label: 'MRO baseline on spreadsheets' },
      { value: '18 mo', label: 'Rolling demand horizon' },
      { value: '10,040', label: 'Projected hours returned / year' },
    ],
    depth: ['Item Master taxonomy and codification establish the common data anchor', 'BOM validation blocks invalid configurations before shipment', 'Serialization carries custody through deployment, return, fault handling, and financial disposition'],
  },
  rfds: {
    tagline: 'Turn engineering documents into outputs of a governed data-and-rules product.',
    goal: 'Generate validated, field-ready RF designs in seconds while preserving engineering control.',
    decisions: ['Data and rules over documents', 'Validate at source', 'Govern flexibility', 'Align fulfillment to design'],
    sequence: ['Source model', 'Rules & governance', 'Automated output', 'Operational alignment'],
    proof: [
      { value: '$1.2M', label: 'Measured annual cost avoidance' },
      { value: '2–4 hrs → <30 sec', label: 'Measured generation time' },
      { value: '35–45% → <5%', label: 'Measured exception rate' },
    ],
    depth: ['RF planning and procurement data are normalized before document generation', 'Sector, frequency, structure, placement, cable, and diagram rules are explicit and testable', 'Existing inventory shipments are validated against the approved RFDS configuration'],
  },
  'gl-coding': {
    tagline: 'Separate changing accounting policy from application architecture.',
    goal: 'Create configurable financial routing that scales to new portfolios without repeating structural development.',
    decisions: ['Policy outside code', 'Common project identity', 'Validate before posting', 'Scalability over the next quick fix'],
    sequence: ['Common identity', 'Policy configuration', 'Routing & validation', 'Reconciliation'],
    proof: [
      { value: '40%', label: 'Measured faster close' },
      { value: '4+', label: 'Observed portfolio adoption' },
      { value: '3', label: 'Enterprise systems aligned' },
    ],
    depth: ['A shared project identifier carries financial context across operations, warehouse, and ERP', 'Metadata-driven lookup rules replace project-specific hard-coded branches', 'The 2–3 month to under one week enablement comparison remains explicitly estimated rather than a production SLA'],
  },
  'lease-vendor-management': {
    tagline: 'Turn lease administration into a governed lease-to-pay financial control system.',
    goal: 'Prevent invalid vendor and payment combinations before they reach Finance.',
    decisions: ['Validate eligibility at source', 'Remove structural address limits', 'Treat lease data as financial-control data', 'Control over one-click speed'],
    sequence: ['Lease lifecycle', 'Vendor scalability', 'Payment controls', 'Financial integrity'],
    proof: [
      { value: '$23.7M/mo', label: 'Actual rent roll governed' },
      { value: '3 → scalable', label: 'Rent-address model' },
      { value: '~2x', label: 'Estimated ROI' },
    ],
    depth: ['Vendor status, rent address, and Oracle identifiers are validated before payment approval', 'VendorOne secondary addresses are surfaced directly in the Lease Management workflow', 'GL/CIP treatment, retention, and audit evidence are governed as part of the lease lifecycle'],
  },
};

const brief = briefs[project.slug]!;
---

<main class="v6-project shell" data-v6-project={project.slug}>
  <div class="v6-projectbar glass-bar">
    <a href={`${base}#work`} class="v6-project-home">← Work</a>
    <details class="v6-project-switcher">
      <summary><span>{project.index}</span><strong>{project.title}</strong><i aria-hidden="true">⌄</i></summary>
      <nav aria-label="Switch project">
        {projects.map((item) => (
          <a href={`${base}work/${item.slug}/`} aria-current={item.slug === project.slug ? 'page' : undefined}>
            <span>{item.index}</span><strong>{item.title}</strong>
          </a>
        ))}
      </nav>
    </details>
    <div class="v6-project-arrows" aria-label="Project navigation">
      <a href={`${base}work/${previousProject.slug}/`} aria-label={`Previous project: ${previousProject.title}`}>←</a>
      <a href={`${base}work/${nextProject.slug}/`} aria-label={`Next project: ${nextProject.title}`}>→</a>
    </div>
  </div>

  <header class="v6-project-intro">
    <div>
      <p class="eyebrow">{project.eyebrow}</p>
      <h1>{project.title}</h1>
      <p>{brief.tagline}</p>
    </div>
    <aside class="v6-goal glass-card">
      <span>Product Goal</span>
      <strong>{brief.goal}</strong>
    </aside>
  </header>

  <section class="v6-dashboard-grid" aria-label={`${project.title} project story`}>
    <article class="v6-visual glass-card">
      <div class="v6-panel-head"><span>Product model</span><small>one scan</small></div>

      {project.slug === 'enterprise-order-management' && (
        <div class="v6-order-map" role="img" aria-label="Business intent is decomposed through the catalog into worker dependencies, shared context, Kafka execution, and provisioning">
          <div class="v6-order-core"><small>DECLARATIVE ENGINE</small><strong>Fulfillment DAG</strong><span>intent → dependencies</span></div>
          <div class="v6-order-node o1"><strong>Hansen</strong><small>decompose</small></div>
          <div class="v6-order-node o2"><strong>Workers</strong><small>propose</small></div>
          <div class="v6-order-node o3"><strong>Kafka</strong><small>push tasks</small></div>
          <div class="v6-order-node o4"><strong>Context</strong><small>shared state</small></div>
          <div class="v6-order-status"><span>assess</span><span>enrich</span><span>phase gate</span><span>execute</span></div>
        </div>
      )}

      {project.slug === 'rag-analysis-agent' && (
        <div class="v6-forecast-map" role="img" aria-label="Live engineering sources flow through hybrid retrieval, reranking, a language model, and grounding verification to produce cited answers">
          <div class="v6-forecast-core"><small>GROUNDING GATE</small><strong>Cited answer</strong><span>answer or abstain</span></div>
          <div class="v6-forecast-node f1"><strong>MCP</strong><small>live sources</small></div>
          <div class="v6-forecast-node f2"><strong>Retrieve</strong><small>hybrid search</small></div>
          <div class="v6-forecast-node f3"><strong>Rerank</strong><small>technical fit</small></div>
          <div class="v6-forecast-node f4"><strong>Claude</strong><small>analysis</small></div>
          <div class="v6-forecast-ring"><span>permissions</span><span>versions</span><span>citations</span></div>
        </div>
      )}

      {project.slug === 'build-plus' && (
        <div class="v6-orbit-map" role="img" aria-label="A governed asset identity connects master data, planning, fulfillment, warehouse custody, and finance across the supply-chain lifecycle">
          <div class="v6-orbit-core"><small>COMMON DATA ANCHOR</small><strong>Asset / part identity</strong></div>
          <div class="v6-orbit-node n1"><strong>Item Master</strong><small>taxonomy</small></div>
          <div class="v6-orbit-node n2"><strong>Planning</strong><small>18-month demand</small></div>
          <div class="v6-orbit-node n3"><strong>OMS</strong><small>validate / route</small></div>
          <div class="v6-orbit-node n4"><strong>WMS</strong><small>custody</small></div>
          <div class="v6-orbit-node n5"><strong>Oracle</strong><small>financial state</small></div>
          <div class="v6-orbit-track"><span>define</span><i>→</i><span>forecast</span><i>→</i><span>fulfill</span><i>→</i><span>recover</span></div>
        </div>
      )}

      {project.slug === 'rfds' && (
        <div class="v6-rfds-map" role="img" aria-label="RF planning and procurement data become a governed site model, engineering rules, validation, and field-ready RFDS output">
          <div class="v6-source-pair"><span>RF planning</span><span>Procurement</span></div><i>↓</i>
          <div class="v6-node is-wide"><strong>Governed site model</strong><small>site · sector · frequency · equipment</small></div><i>↓</i>
          <div class="v6-rule-cloud"><strong>Rules</strong><span>sector</span><span>placement</span><span>frequency</span><span>cable</span></div><i>↓</i>
          <div class="v6-branch"><div><strong>Valid</strong><small>generate</small></div><div><strong>Exception</strong><small>correct / review</small></div></div><i>↓</i>
          <div class="v6-node is-result is-wide"><strong>RFDS + diagrams</strong><small>approved · field-ready · traceable</small></div>
        </div>
      )}

      {project.slug === 'gl-coding' && (
        <div class="v6-gl-map" role="img" aria-label="Business context and common project identity flow through configurable accounting policy, validation, posting, and evidence">
          <div class="v6-signal-row"><span>project ID</span><span>activity</span><span>item</span><span>portfolio</span></div><i>↓</i>
          <div class="v6-node is-accent is-wide"><strong>Configurable policy</strong><small>lookup tables · mappings · exceptions</small></div><i>↓</i>
          <div class="v6-control-track"><span>assemble</span><i>→</i><span>validate</span><i>→</i><span>post</span></div><i>↓</i>
          <div class="v6-branch"><div><strong>GL treatment</strong><small>consistent routing</small></div><div><strong>Evidence</strong><small>reason · approver · lineage</small></div></div>
        </div>
      )}

      {project.slug === 'lease-vendor-management' && (
        <div class="v6-flow-map v6-asset" role="img" aria-label="Lease lifecycle and vendor data pass through eligibility validation, payment generation, Oracle execution, and reconciliation">
          <div class="v6-input-stack"><span>Lease</span><span>VendorOne</span><span>Rent address</span></div>
          <i>→</i><div class="v6-node is-accent"><small>VALIDATE</small><strong>Payment eligibility</strong></div>
          <i>→</i><div class="v6-node"><strong>Schedule</strong><small>lease obligation</small></div>
          <i>→</i><div class="v6-node"><strong>Oracle</strong><small>GL / payment</small></div>
          <i>→</i><div class="v6-node is-result"><strong>Reconcile</strong><small>evidence / closeout</small></div>
        </div>
      )}
    </article>

    <aside class="v6-decision-panel glass-card">
      <div class="v6-panel-head"><span>Product decisions</span><small>why this worked</small></div>
      <div class="v6-decision-list">
        {brief.decisions.map((decision, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><strong>{decision}</strong></div>)}
      </div>
      <div class="v6-sequence">
        <small>Backlog / delivery sequence</small>
        <div>{brief.sequence.map((step, index) => <><span>{step}</span>{index < brief.sequence.length - 1 && <i>→</i>}</>)}</div>
      </div>
    </aside>
  </section>

  <section class="v6-proof-row" aria-label="Business value and evidence">
    {brief.proof.map((item) => <article class="glass-card"><strong>{item.value}</strong><span>{item.label}</span></article>)}
    <details class="v6-depth glass-card">
      <summary><span>Deeper reasoning</span><strong>+</strong></summary>
      <ul>{brief.depth.map((item) => <li>{item}</li>)}</ul>
    </details>
  </section>

  <details class="v6-full-case glass-card">
    <summary>
      <div><span>Full case study</span><strong>{project.headline}</strong></div>
      <i aria-hidden="true">+</i>
    </summary>
    <div class="v6-full-case-body">
      <section class="v6-case-two">
        <article>
          <small>Business problem</small>
          <h2>{project.question}</h2>
          <p>{project.problem}</p>
        </article>
        <article>
          <small>Product goal</small>
          <h2>What I optimized for</h2>
          <p>{project.productGoal}</p>
        </article>
      </section>

      <section class="v6-case-two">
        <article>
          <small>My ownership</small>
          <h2>Senior TPO scope</h2>
          <ul>{project.ownership.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <small>Complexity</small>
          <h2>What made this hard</h2>
          <ul>{project.complexity.map((item) => <li>{item}</li>)}</ul>
        </article>
      </section>

      <section class="v6-case-flow">
        <small>End-to-end product flow</small>
        <div>{project.flow.map((step, index) => <><span>{step}</span>{index < project.flow.length - 1 && <i>→</i>}</>)}</div>
        <p>{project.flowCaption}</p>
      </section>

      <section>
        <div class="v6-case-heading"><small>Delivery</small><h2>How the capability was sequenced</h2></div>
        <div class="v6-case-increments">
          {project.increments.map((increment, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{increment.title}</h3>
              <strong>{increment.focus}</strong>
              <p>{increment.learning}</p>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="v6-case-heading"><small>Evidence</small><h2>Outcomes with qualification intact</h2></div>
        <p class="v6-case-value">{project.valueNarrative}</p>
        <div class="v6-case-metrics">
          {project.metrics.map((metric) => (
            <article>
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
              <p>{metric.detail}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </details>
</main>

<style>
  .v6-full-case{margin-top:18px;overflow:hidden}
  .v6-full-case>summary{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:20px 22px;cursor:pointer;list-style:none}
  .v6-full-case>summary::-webkit-details-marker{display:none}
  .v6-full-case>summary div{display:grid;gap:5px}
  .v6-full-case>summary span,.v6-case-two small,.v6-case-flow>small,.v6-case-heading small{font-size:.56rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#7290aa}
  .v6-full-case>summary strong{font-size:.9rem;color:#1d405d}
  .v6-full-case>summary i{display:grid;width:32px;height:32px;place-items:center;border-radius:10px;background:rgba(233,242,254,.9);font-style:normal;color:#315d85}
  .v6-full-case[open]>summary i{transform:rotate(45deg)}
  .v6-full-case-body{display:grid;gap:14px;padding:0 14px 14px}
  .v6-case-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .v6-case-two article,.v6-case-flow,.v6-case-increments article,.v6-case-metrics article{border:1px solid rgba(37,99,235,.08);border-radius:16px;background:rgba(255,255,255,.62)}
  .v6-case-two article{padding:20px}
  .v6-case-two h2,.v6-case-heading h2{margin:7px 0 10px;font-size:clamp(1.35rem,2.3vw,2rem);color:#193f5f}
  .v6-case-two p,.v6-case-two li,.v6-case-flow p,.v6-case-value,.v6-case-increments p,.v6-case-metrics p{font-size:.72rem;line-height:1.58;color:#647c91}
  .v6-case-two ul{display:grid;gap:8px;margin:12px 0 0;padding-left:18px}
  .v6-case-flow{padding:20px}
  .v6-case-flow>div{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin:12px 0}
  .v6-case-flow span{padding:6px 9px;border-radius:999px;background:rgba(233,242,254,.9);font-size:.6rem;font-weight:750;color:#4f708b}
  .v6-case-flow i{font-style:normal;color:#8ca4b8}
  .v6-case-flow p{margin:0;max-width:900px}
  .v6-case-heading{padding:12px 6px 2px}
  .v6-case-increments,.v6-case-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
  .v6-case-increments article,.v6-case-metrics article{padding:16px}
  .v6-case-increments article>span{font-size:.55rem;font-weight:800;color:#7890a6}
  .v6-case-increments h3{margin:8px 0 7px;font-size:.9rem;color:#1d425f}
  .v6-case-increments strong{font-size:.64rem;line-height:1.4;color:#42617a}
  .v6-case-increments p{margin:9px 0 0}
  .v6-case-value{max-width:980px;margin:0 6px 14px}
  .v6-case-metrics strong{display:block;font-size:1.35rem;color:#1b4f79}
  .v6-case-metrics span{display:block;margin-top:5px;font-size:.62rem;font-weight:800;color:#355c7a}
  .v6-case-metrics p{margin:8px 0 0}
  @media (max-width:820px){.v6-case-two,.v6-case-increments,.v6-case-metrics{grid-template-columns:1fr}.v6-full-case>summary{align-items:flex-start}.v6-full-case>summary strong{font-size:.78rem}}
</style>

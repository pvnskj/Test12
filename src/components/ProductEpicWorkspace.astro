---
import { projects, type Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length]!;

const publicText = (value: string) => value
  .replace(/Hansen/gi, 'product catalog')
  .replace(/Camunda/gi, 'legacy workflow engine')
  .replace(/Change Bucket/gi, 'service-change use case')
  .replace(/\bUC1\b/gi, 'initial use case')
  .replace(/VendorOne/gi, 'vendor management platform')
  .replace(/GitLab/gi, 'code repositories')
  .replace(/Jira/gi, 'work tracking')
  .replace(/Confluence/gi, 'knowledge base')
  .replace(/AWS Bedrock/gi, 'private model platform')
  .replace(/FastAPI/gi, 'API service')
  .replace(/\bOracle\b/gi, 'ERP')
  .replace(/\bQDS\b/gi, 'engineering data source')
  .replace(/\bN1\b/g, 'operations platform');

const approachBySlug: Record<string, string[]> = {
  'rag-analysis-agent': ['Grounded', 'Traceable', 'Permission-aware', 'Evaluated'],
  'build-plus': ['Lifecycle', 'Data-first', 'Governed', 'Traceable'],
  rfds: ['Rules-first', 'Governed data', 'Reusable', 'Evidence-led'],
  'gl-coding': ['Policy-led', 'Configurable', 'Validated', 'Traceable'],
  'lease-vendor-management': ['Control-first', 'Governed', 'Auditable', 'Reusable'],
};

const approaches = approachBySlug[project.slug] ?? ['Outcome-first', 'Configurable', 'Governed', 'Evidence-led'];
const epicCode = `EPIC-${project.index}`;

const metricType = (detail: string, label: string) => {
  const text = `${detail} ${label}`.toLowerCase();
  if (text.includes('projected') || text.includes('modeled') || text.includes('target')) return 'Projected';
  if (text.includes('estimated')) return 'Estimated';
  if (text.includes('measured') || text.includes('observed')) return 'Measured';
  return 'Evidence';
};

const focusDetails = project.increments.map((increment, index) => {
  const capabilities = increment.focus.split(',').map((item) => publicText(item.trim())).filter(Boolean);
  const complexity = project.complexity.filter((_, itemIndex) => itemIndex % project.increments.length === index).map(publicText);
  const ownership = project.ownership.filter((_, itemIndex) => itemIndex % project.increments.length === index).map(publicText);
  const decision = project.decisions[index % project.decisions.length]!;
  const evidence = project.metrics[index % project.metrics.length]!;
  return { increment, capabilities, complexity, ownership, decision, evidence };
});
---

<main class="product-workspace shell" data-project-slug={project.slug}>
  <nav class="workspace-bar glass-bar" aria-label="Project navigation">
    <a href={`${base}#work`}>← Back to portfolio</a>
    <div class="workspace-key"><span>{epicCode}</span><b>Epic overview</b></div>
    <a href={`${base}work/${nextProject.slug}/`}>Next project →</a>
  </nav>

  <section class="epic-header glass-card" aria-labelledby={`${project.slug}-title`}>
    <div class="epic-main">
      <span class="category-pill">{publicText(project.category)}</span>
      <h1 id={`${project.slug}-title`}>{project.title}</h1>
      <p>{publicText(project.headline)}</p>
      <div class="approach-tags" aria-label="Product approach">
        {approaches.map((tag) => <span>{tag}</span>)}
      </div>
    </div>

    <aside class="epic-facts" aria-label="Epic facts">
      {project.metrics.slice(0, 3).map((metric) => (
        <div>
          <small>{metricType(metric.detail, metric.label)}</small>
          <strong>{metric.value}</strong>
          <span>{publicText(metric.label)}</span>
        </div>
      ))}
    </aside>
  </section>

  <section class="evidence-strip" aria-label="Key evidence">
    {project.metrics.map((metric) => (
      <article class="glass-card">
        <div><span>{metricType(metric.detail, metric.label)}</span><strong>{metric.value}</strong></div>
        <p>{publicText(metric.label)}</p>
      </article>
    ))}
  </section>

  <section class="overview-section" aria-labelledby={`${project.slug}-overview`}>
    <div class="section-label"><span>The big picture</span><h2 id={`${project.slug}-overview`}>Why this product had to change</h2></div>
    <p class="overview-copy">{publicText(project.summary)}</p>

    <div class="story-grid">
      <article class="glass-card">
        <span>Problem</span>
        <h3>{publicText(project.question)}</h3>
        <p>{publicText(project.problem)}</p>
      </article>
      <article class="glass-card">
        <span>Product decision</span>
        <h3>{publicText(project.decisions[0]?.title ?? 'Change the operating model')}</h3>
        <p>{publicText(project.productGoal)}</p>
      </article>
      <article class="glass-card outcome-card">
        <span>Outcome</span>
        <h3>{publicText(project.headline)}</h3>
        <p>{publicText(project.valueNarrative)}</p>
      </article>
    </div>
  </section>

  <section class="decision-section" aria-labelledby={`${project.slug}-decisions`}>
    <div class="section-label"><span>Key product decisions</span><h2 id={`${project.slug}-decisions`}>Why the product moved this way</h2></div>
    <div class="decision-table glass-card">
      {project.decisions.map((decision, index) => (
        <article>
          <b>{String(index + 1).padStart(2, '0')}</b>
          <h3>{publicText(decision.title)}</h3>
          <p>{publicText(decision.body)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="flow-section glass-card" aria-labelledby={`${project.slug}-flow`}>
    <div class="flow-copy">
      <span>Product flow</span>
      <h2 id={`${project.slug}-flow`}>{publicText(project.flowCaption)}</h2>
    </div>
    <div class="flow-track" aria-label="Simplified product flow">
      {project.flow.map((step, index) => (
        <div class="flow-step"><b>{String(index + 1).padStart(2, '0')}</b><span>{publicText(step)}</span></div>
      ))}
    </div>
  </section>

  <section class="focus-section" aria-labelledby={`${project.slug}-focus`}>
    <div class="focus-heading">
      <div class="section-label"><span>Focus areas</span><h2 id={`${project.slug}-focus`}>Open a capability to see the detail</h2></div>
      <p>One Epic, one page. Each focus area expands in place with what I owned, what was hard, the product decision, learning, and evidence behind it.</p>
    </div>

    <div class="feature-list" data-feature-list>
      {focusDetails.map(({ increment, capabilities, complexity, ownership, decision, evidence }, index) => (
        <details class="feature-item glass-card" data-feature>
          <summary>
            <div class="feature-key"><span>FOCUS-{String(index + 1).padStart(2, '0')}</span><b>{String(index + 1).padStart(2, '0')}</b></div>
            <div class="feature-summary-copy">
              <h3>{publicText(increment.title)}</h3>
              <p>{publicText(increment.focus)}</p>
            </div>
            <div class="feature-signal"><strong>{evidence.value}</strong><span>{metricType(evidence.detail, evidence.label)}</span></div>
            <span class="feature-toggle" aria-hidden="true">＋</span>
          </summary>

          <div class="feature-detail">
            <nav class="detail-tabs" aria-label={`${increment.title} detail sections`}>
              <span>Overview</span><span>Ownership</span><span>Decision</span><span>Evidence</span>
            </nav>

            <div class="detail-intro">
              <article>
                <small>Why this matters</small>
                <h4>The product question behind this focus area</h4>
                <p>{publicText(increment.learning)}</p>
              </article>
              <article>
                <small>Focus</small>
                <h4>{publicText(increment.title)}</h4>
                <p>{publicText(increment.focus)}</p>
              </article>
            </div>

            <div class="detail-pair">
              <article class="detail-card">
                <small>Capabilities delivered</small>
                <ul>{capabilities.map((item) => <li>{item}</li>)}</ul>
              </article>
              <article class="detail-card">
                <small>What was hard</small>
                <ul>{complexity.map((item) => <li>{item}</li>)}</ul>
              </article>
            </div>

            <section class="ownership-panel">
              <div><small>What I owned</small><h4>Ownership is visible in the product choices and sequencing.</h4></div>
              <ul>{ownership.map((item) => <li>{item}</li>)}</ul>
            </section>

            <div class="decision-evidence-grid">
              <section class="focus-decision">
                <small>Product decision</small>
                <article>
                  <b>{String(index + 1).padStart(2, '0')}</b>
                  <div><h4>{publicText(decision.title)}</h4><p>{publicText(decision.body)}</p></div>
                </article>
              </section>

              <section class="feature-evidence">
                <div><small>What the number means</small><strong>{evidence.value}</strong><h4>{publicText(evidence.label)}</h4><span>{metricType(evidence.detail, evidence.label)}</span></div>
                <p>{publicText(evidence.detail)}</p>
              </section>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="record-section" aria-labelledby={`${project.slug}-record`}>
    <div class="section-label"><span>Product record</span><h2 id={`${project.slug}-record`}>The complete ownership and complexity context</h2></div>
    <div class="record-grid">
      <article class="glass-card">
        <small>What I owned</small>
        <ul>{project.ownership.map((item) => <li>{publicText(item)}</li>)}</ul>
      </article>
      <article class="glass-card">
        <small>What was hard</small>
        <ul>{project.complexity.map((item) => <li>{publicText(item)}</li>)}</ul>
      </article>
    </div>
  </section>

  <section class="evidence-note glass-card" aria-labelledby={`${project.slug}-evidence-note`}>
    <div><span>Evidence discipline</span><h2 id={`${project.slug}-evidence-note`}>The number is only useful if the reader knows what it proves.</h2></div>
    <div class="evidence-lines">
      {project.metrics.map((metric) => (
        <article>
          <strong>{metric.value}</strong>
          <div><span>{metricType(metric.detail, metric.label)} · {publicText(metric.label)}</span><p>{publicText(metric.detail)}</p></div>
        </article>
      ))}
    </div>
  </section>

  <a class="next-epic glass-card" href={`${base}work/${nextProject.slug}/`}>
    <span>Next epic</span><strong>{nextProject.title}</strong><b aria-hidden="true">→</b>
  </a>
</main>

<script>
  const featureItems = Array.from(document.querySelectorAll('[data-feature]'));
  featureItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!(item instanceof HTMLDetailsElement) || !item.open) return;
      featureItems.forEach((other) => {
        if (other !== item && other instanceof HTMLDetailsElement) other.open = false;
      });
    });
  });
</script>


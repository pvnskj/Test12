lace-items:center;width:24px;height:24px;border-radius:7px;background:rgba(230,239,255,.9);font-size:.51rem;color:#3266ad}.focus-decision h4{margin:0 0 4px}.feature-evidence{display:grid;grid-template-columns:110px 1fr;gap:15px;align-items:center}.feature-evidence strong{display:block;margin:7px 0 2px;font-size:1.1rem;color:#2162bd}.feature-evidence h4{margin:0}.feature-evidence div>span{font-size:.48rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#8094a7}

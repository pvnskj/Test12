---
import { eomEpic, eomFocusAreas, type EomFocusArea } from '../data/eomCase';

interface Props { focus: EomFocusArea; }
const { focus } = Astro.props;
const base = import.meta.env.BASE_URL;
const index = eomFocusAreas.findIndex((item) => item.slug === focus.slug);
const previous = eomFocusAreas[index - 1];
const next = eomFocusAreas[index + 1];
---

<main class="eom-focus shell">
  <nav class="focus-bar glass-bar" aria-label="Focus area navigation">
    <a href={`${base}work/enterprise-order-management/`}>← Back to epic</a>
    <span>{eomEpic.code} / {focus.code}</span>
    <div class="focus-nav-arrows">
      {previous ? <a aria-label={`Previous: ${previous.title}`} href={`${base}work/enterprise-order-management/${previous.slug}/`}>←</a> : <span aria-hidden="true">←</span>}
      {next ? <a aria-label={`Next: ${next.title}`} href={`${base}work/enterprise-order-management/${next.slug}/`}>→</a> : <span aria-hidden="true">→</span>}
    </div>
  </nav>

  <header class="focus-hero">
    <div>
      <span class="focus-label">Focus area</span>
      <h1>{focus.title}</h1>
      <p>{focus.purpose}</p>
    </div>
    <aside class="focus-state glass-card">
      <span>Product signal</span>
      <strong>{focus.evidence[0]?.value ?? 'Qualitative'}</strong>
      <small>{focus.evidence[0]?.label ?? 'Product learning'}</small>
    </aside>
  </header>

  <nav class="section-tabs glass-card" aria-label="Case study sections">
    <a href="#overview">Overview</a>
    <a href="#decisions">Decisions</a>
    <a href="#system-flow">System flow</a>
    <a href="#evidence">Evidence</a>
  </nav>

  <section id="overview" class="focus-overview" aria-labelledby="overview-title">
    <div class="at-a-glance">
      <article class="glass-card">
        <span>Purpose</span>
        <strong>{focus.shortTitle}</strong>
        <p>{focus.purpose}</p>
      </article>
      <article class="glass-card">
        <span>Scope</span>
        <strong>{focus.capabilities.length} capabilities</strong>
        <p>Core product capabilities grouped around this focus area.</p>
      </article>
      <article class="glass-card">
        <span>Product lens</span>
        <strong>{index === 0 ? 'Dependency-first' : index === 1 ? 'Intent-to-work' : index === 2 ? 'Governed state' : 'Scale with control'}</strong>
        <p>The product principle used to make the trade-offs in this area.</p>
      </article>
      <article class="glass-card">
        <span>Evidence</span>
        <strong>{focus.evidence[0]?.type ?? 'Qualitative'}</strong>
        <p>{focus.evidence[0]?.detail ?? 'Learning captured through delivery and product validation.'}</p>
      </article>
    </div>

    <div class="why-section">
      <div class="section-heading">
        <span>Why this matters</span>
        <h2 id="overview-title">The product problem behind this focus area.</h2>
      </div>
      <p>{focus.whyItMatters}</p>
    </div>

    <div class="detail-pair">
      <article class="glass-card">
        <span>Capabilities delivered</span>
        <ul>{focus.capabilities.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="glass-card">
        <span>Challenges & trade-offs</span>
        <ul>{focus.challenges.map((item) => <li>{item}</li>)}</ul>
      </article>
    </div>
  </section>

  <section id="decisions" class="focus-decisions" aria-labelledby="decisions-title">
    <div class="section-heading">
      <span>What I owned</span>
      <h2 id="decisions-title">Product ownership showed up in the choices, not the ceremony.</h2>
    </div>
    <div class="ownership-decisions">
      <div class="ownership-list glass-card">
        {focus.ownership.map((item) => <p>{item}</p>)}
      </div>
      <div class="decision-stack">
        {focus.decisions.map((decision, decisionIndex) => (
          <article class="glass-card">
            <span>Decision {String(decisionIndex + 1).padStart(2, '0')}</span>
            <h3>{decision.title}</h3>
            <p>{decision.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="system-flow" class="system-section" aria-labelledby="system-title">
    <div class="section-heading">
      <span>System flow · simplified</span>
      <h2 id="system-title">Enough architecture to explain the product decision.</h2>
    </div>
    <div class="system-layout">
      <div class="system-map glass-card" aria-label={`${focus.title} simplified flow`}>
        {focus.flow.map((step, stepIndex) => (
          <>
            <div class="system-node"><span>{String(stepIndex + 1).padStart(2, '0')}</span><strong>{step}</strong></div>
            {stepIndex < focus.flow.length - 1 && <b aria-hidden="true">→</b>}
          </>
        ))}
      </div>
      <aside class="learning-card glass-card">
        <span>Product learning</span>
        <h3>What changed my thinking</h3>
        <p>{focus.learning}</p>
      </aside>
    </div>
  </section>

  <section id="evidence" class="focus-evidence" aria-labelledby="evidence-title">
    <div class="section-heading">
      <span>Results & evidence</span>
      <h2 id="evidence-title">What the evidence actually proves.</h2>
    </div>
    <div class="result-grid">
      {focus.evidence.map((metric) => (
        <article class="glass-card">
          <span>{metric.type}</span>
          <strong>{metric.value}</strong>
          <h3>{metric.label}</h3>
          <p>{metric.detail}</p>
        </article>
      ))}
      <article class="glass-card evidence-principle">
        <span>Evidence principle</span>
        <h3>No inflated claims</h3>
        <p>Measured results, actual delivery scope, and projected capacity remain visibly separated so the reader can tell what happened from what the architecture was designed to support.</p>
      </article>
    </div>
  </section>

  <footer class="focus-next glass-card">
    <div>
      <span>{next ? 'Next focus area' : 'Back to epic'}</span>
      <strong>{next?.title ?? eomEpic.title}</strong>
      <p>{next?.purpose ?? 'Return to the project overview and explore the complete product story.'}</p>
    </div>
    <a href={next ? `${base}work/enterprise-order-management/${next.slug}/` : `${base}work/enterprise-order-management/`}>
      {next ? 'View next →' : 'Back to epic →'}
    </a>
  </footer>
</main>

<style>
  .eom-focus{padding:20px 0 72px;color:#102f50}
  .focus-bar{position:sticky;top:92px;z-index:40;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;min-height:54px;margin-bottom:26px;padding:8px 12px}.focus-bar>a{padding:8px 10px;font-size:.68rem;font-weight:760;color:#5f7890}.focus-bar>span{font-size:.62rem;font-weight:850;letter-spacing:.08em;color:#587691}.focus-nav-arrows{justify-self:end;display:flex;gap:6px}.focus-nav-arrows a,.focus-nav-arrows span{display:grid;place-items:center;width:30px;height:30px;border:1px solid rgba(43,91,145,.12);border-radius:10px;background:rgba(255,255,255,.64);font-size:.7rem;color:#456b93}.focus-nav-arrows span{opacity:.32}

  .focus-hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(240px,.55fr);gap:20px;align-items:end;padding:24px 6px 20px}.focus-label,.focus-state>span,.at-a-glance span,.section-heading>span,.detail-pair article>span,.decision-stack article>span,.learning-card>span,.result-grid article>span{display:block;font-size:.56rem;font-weight:850;letter-spacing:.095em;text-transform:uppercase;color:#7990a5}.focus-hero h1{margin:10px 0 10px;font-size:clamp(2.7rem,5vw,4.6rem);line-height:.97;letter-spacing:-.05em}.focus-hero>div>p{max-width:800px;margin:0;color:#5f778e;font-size:.94rem;line-height:1.62}.focus-state{padding:21px}.focus-state strong{display:block;margin:8px 0 3px;font-size:1.55rem;color:#2061b8}.focus-state small{color:#70869b;font-size:.65rem}

  .section-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:7px 0 34px;padding:5px}.section-tabs a{padding:9px 12px;border-radius:10px;text-align:center;font-size:.61rem;font-weight:800;color:#637e98}.section-tabs a:first-child{background:linear-gradient(135deg,#2461b5,#3476cb);color:#fff;box-shadow:0 6px 18px rgba(36,97,181,.16)}

  .at-a-glance{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.at-a-glance article{padding:18px;min-height:145px}.at-a-glance strong{display:block;margin:8px 0 5px;font-size:.82rem;color:#173b5b}.at-a-glance p{margin:0;color:#6d8397;font-size:.64rem;line-height:1.48}

  .why-section,.focus-decisions,.system-section,.focus-evidence{padding-top:48px}.section-heading{max-width:800px;margin-bottom:17px}.section-heading h2{margin:8px 0 0;font-size:clamp(1.9rem,3.4vw,2.8rem);line-height:1.04;letter-spacing:-.038em;color:#153856}.why-section>p{max-width:1000px;margin:0;color:#5e778e;font-size:.82rem;line-height:1.7}

  .detail-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:20px}.detail-pair article{padding:22px}.detail-pair ul{display:grid;gap:10px;margin:15px 0 0;padding:0;list-style:none}.detail-pair li{position:relative;padding-left:20px;color:#5f7990;font-size:.71rem;line-height:1.5}.detail-pair li:before{content:'✓';position:absolute;left:0;top:0;color:#2e8f75;font-weight:900}

  .ownership-decisions{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:10px}.ownership-list{padding:10px 22px}.ownership-list p{margin:0;padding:14px 0;border-bottom:1px solid rgba(20,55,84,.07);color:#607a91;font-size:.72rem;line-height:1.55}.ownership-list p:last-child{border-bottom:0}.decision-stack{display:grid;gap:10px}.decision-stack article{padding:20px}.decision-stack h3{margin:9px 0 6px;font-size:.92rem;color:#173b5b}.decision-stack p{margin:0;color:#697f94;font-size:.7rem;line-height:1.55}

  .system-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:10px}.system-map{display:flex;align-items:center;justify-content:center;gap:8px;min-height:220px;padding:24px;overflow:auto}.system-node{display:grid;gap:5px;min-width:125px;padding:16px;border:1px solid rgba(48,100,172,.1);border-radius:14px;background:rgba(248,251,255,.78);text-align:center}.system-node span{font-size:.5rem;font-weight:850;color:#7a93ab}.system-node strong{font-size:.68rem;line-height:1.3;color:#264d71}.system-map>b{color:#90a5b8;font-size:.8rem}.learning-card{padding:22px}.learning-card h3{margin:9px 0 8px;font-size:1rem;color:#183b5b}.learning-card p{margin:0;color:#657d93;font-size:.73rem;line-height:1.6}

  .result-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.result-grid article{padding:22px}.result-grid strong{display:block;margin:8px 0 3px;font-size:1.5rem;color:#2061b8}.result-grid h3{margin:0 0 7px;font-size:.82rem;color:#173b5b}.result-grid p{margin:0;color:#687f95;font-size:.69rem;line-height:1.55}.evidence-principle{background:linear-gradient(145deg,rgba(246,251,255,.92),rgba(255,255,255,.72))}

  .focus-next{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;margin-top:48px;padding:20px 22px}.focus-next span{font-size:.54rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:#8194a7}.focus-next strong{display:block;margin:5px 0 3px;font-size:.86rem;color:#1d4468}.focus-next p{max-width:760px;margin:0;color:#70869a;font-size:.65rem;line-height:1.45}.focus-next>a{font-size:.66rem;font-weight:800;color:#3268b2}

  @media(max-width:900px){.focus-hero,.ownership-decisions,.system-layout{grid-template-columns:1fr}.at-a-glance{grid-template-columns:repeat(2,minmax(0,1fr))}.system-map{justify-content:flex-start}.detail-pair{grid-template-columns:1fr}}
  @media(max-width:600px){.eom-focus{padding-top:10px}.focus-bar{top:70px;grid-template-columns:1fr auto;margin-bottom:12px}.focus-bar>span{display:none}.focus-hero{padding-top:14px}.focus-hero h1{font-size:2.45rem}.section-tabs{grid-template-columns:repeat(2,1fr)}.at-a-glance{grid-template-columns:1fr}.system-map{display:grid;grid-template-columns:1fr;overflow:visible}.system-node{min-width:0}.system-map>b{transform:rotate(90deg);text-align:center}.result-grid{grid-template-columns:1fr}.focus-next{grid-template-columns:1fr}.focus-next>a{justify-self:start}.why-section,.focus-decisions,.system-section,.focus-evidence{padding-top:40px}}
</style>

---
import { projects, type Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const previousProject = projects[(currentIndex - 1 + projects.length) % projects.length]!;
const nextProject = projects[(currentIndex + 1) % projects.length]!;
---

<main class="glc-dashboard shell" data-gl-coding-dashboard>
  <header class="glc-commandbar glass-bar">
    <a class="glc-brand" href={`${base}#work`} aria-label="Back to selected work">
      <span class="glc-project-index">05</span>
      <span>
        <strong>Dynamic GL Coding</strong>
        <small>Financial controls · Configurable policy</small>
      </span>
    </a>

    <details class="glc-switcher">
      <summary>Switch project <span aria-hidden="true">⌄</span></summary>
      <nav aria-label="Switch project">
        {projects.map((item) => (
          <a href={`${base}work/${item.slug}/`} aria-current={item.slug === project.slug ? 'page' : undefined}>
            <span>{item.index}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
      </nav>
    </details>
  </header>

  <section class="glc-hero" aria-labelledby="glc-title">
    <div>
      <p class="eyebrow">Financial product controls</p>
      <h1 id="glc-title">Configurable policy. Auditable decisions.</h1>
      <p>Separate changing accounting policy from application code so new project types can be coded accurately without turning every policy change into a software release.</p>
    </div>
    <aside class="glc-role-card glass-card" aria-label="Product ownership focus">
      <span>Product ownership focus</span>
      <strong>Policy → decision → posting → evidence</strong>
      <small>Senior TPO · representative initiative</small>
    </aside>
  </section>

  <section class="glc-kpis" aria-label="GL Coding snapshot">
    <article class="glass-card">
      <span>Business outcome</span>
      <strong>40%</strong>
      <small>faster month-end close</small>
    </article>
    <article class="glass-card">
      <span>Product goal</span>
      <strong>Accurate + auditable</strong>
      <small>coding across changing project types</small>
    </article>
    <article class="glass-card">
      <span>Design choice</span>
      <strong>Configurable policy</strong>
      <small>instead of hard-coded logic</small>
    </article>
    <article class="glass-card">
      <span>Control</span>
      <strong>Traceable</strong>
      <small>mapping evidence and review path</small>
    </article>
  </section>

  <section class="glc-main-grid">
    <article class="glc-policy-panel glass-card" aria-labelledby="glc-policy-title">
      <header>
        <span>01 · Product model</span>
        <h2 id="glc-policy-title">Policy becomes a controlled decision pipeline.</h2>
      </header>

      <div class="glc-context-row" aria-label="Business context inputs">
        <span>Project type</span>
        <span>Entity</span>
        <span>Activity</span>
        <span>Spend</span>
        <span>Asset context</span>
      </div>

      <div class="glc-flow" role="img" aria-label="Business context flows through configurable policy, review controls, validated GL coding, posting, and audit evidence">
        <div class="glc-flow-node is-policy">
          <small>RULES</small>
          <strong>Configurable policy</strong>
          <span>lookup tables · mapping rules · exceptions</span>
        </div>
        <i aria-hidden="true">→</i>
        <div class="glc-flow-node">
          <small>CONTROL</small>
          <strong>Simulate + review</strong>
          <span>validate before irreversible action</span>
        </div>
        <i aria-hidden="true">→</i>
        <div class="glc-flow-node is-result">
          <small>OUTPUT</small>
          <strong>Validated GL code</strong>
          <span>consistent financial treatment</span>
        </div>
        <i aria-hidden="true">→</i>
        <div class="glc-flow-node">
          <small>EVIDENCE</small>
          <strong>Post + trace</strong>
          <span>approver · reason · lineage</span>
        </div>
      </div>

      <div class="glc-callout">
        <span>Core abstraction</span>
        <strong>Policy can change while the product architecture stays stable.</strong>
      </div>
    </article>

    <aside class="glc-decisions glass-card" aria-labelledby="glc-decisions-title">
      <header>
        <span>02 · Product decisions</span>
        <h2 id="glc-decisions-title">Three choices mattered.</h2>
      </header>

      <div class="glc-decision-row">
        <span>01</span>
        <div>
          <strong>Decouple policy from code</strong>
          <small>Finance can change mappings without rebuilding the product.</small>
        </div>
      </div>
      <div class="glc-decision-row">
        <span>02</span>
        <div>
          <strong>Keep review before posting</strong>
          <small>Automate repeatable logic; keep exceptions inspectable.</small>
        </div>
      </div>
      <div class="glc-decision-row">
        <span>03</span>
        <div>
          <strong>Design for the next project type</strong>
          <small>Configuration should absorb growth before architecture has to.</small>
        </div>
      </div>
    </aside>
  </section>

  <section class="glc-support-grid">
    <article class="glc-backlog glass-card" aria-labelledby="glc-backlog-title">
      <header>
        <span>03 · Backlog strategy</span>
        <h2 id="glc-backlog-title">Reduce the riskiest uncertainty first.</h2>
      </header>
      <div class="glc-backlog-track" role="img" aria-label="Delivery sequence from component model to configurable policy, decision controls, and posting evidence">
        <div><span>01</span><strong>Component model</strong><small>Can the code represent current and emerging project types?</small></div>
        <i>→</i>
        <div><span>02</span><strong>Configurable policy</strong><small>Can finance change mappings safely?</small></div>
        <i>→</i>
        <div><span>03</span><strong>Decision controls</strong><small>Can speed improve without losing governance?</small></div>
        <i>→</i>
        <div><span>04</span><strong>Posting + evidence</strong><small>Can every result be explained after the fact?</small></div>
      </div>
    </article>

    <article class="glc-value glass-card" aria-labelledby="glc-value-title">
      <header>
        <span>04 · Business value</span>
        <h2 id="glc-value-title">Less rework. Faster close. Better control.</h2>
      </header>
      <div class="glc-value-metric">
        <strong>40%</strong>
        <span>faster month-end close</span>
      </div>
      <div class="glc-value-signal">
        <span>Mapping evidence</span>
        <strong>Traceable</strong>
      </div>
      <small class="glc-evidence-note">Based on the existing GL Coding impact material in this portfolio.</small>
    </article>
  </section>

  <details class="glc-depth glass-card">
    <summary>
      <span>Want the deeper product reasoning?</span>
      <strong>Open</strong>
    </summary>
    <div class="glc-depth-grid">
      <section>
        <span>Why this was hard</span>
        <ul>
          <li>CapEx / OpEx treatment varied by project context.</li>
          <li>GL codes were assembled from multiple governed components.</li>
          <li>Policy needed agility without weakening posting controls.</li>
        </ul>
      </section>
      <section>
        <span>What I owned</span>
        <ul>
          <li>Product boundary and Product Goal.</li>
          <li>Backlog ordering around policy and control risk.</li>
          <li>Decision transparency, review, and auditability.</li>
        </ul>
      </section>
    </div>
  </details>

  <footer class="glc-footer">
    <a href={`${base}work/${previousProject.slug}/`}><span>← Previous</span><strong>{previousProject.title}</strong></a>
    <a href={`${base}work/${nextProject.slug}/`}><span>Next →</span><strong>{nextProject.title}</strong></a>
  </footer>
</main>

<style>
  .glc-dashboard{padding:28px 0 88px}
  .glc-commandbar{position:sticky;top:76px;z-index:70;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:8px 10px 8px 14px;border-radius:18px}
  .glc-brand{display:flex;align-items:center;gap:10px;min-width:0}.glc-project-index{display:grid;width:34px;height:34px;place-items:center;border-radius:10px;background:#102b47;color:#fff;font-size:.65rem;font-weight:800}.glc-brand>span:last-child{display:grid;min-width:0}.glc-brand strong{font-size:.76rem;color:#183650}.glc-brand small{font-size:.58rem;color:#7a8fa3}
  .glc-switcher{position:relative}.glc-switcher summary{display:flex;align-items:center;gap:7px;padding:9px 12px;border-radius:11px;background:rgba(235,243,253,.78);color:#315470;font-size:.64rem;font-weight:750;cursor:pointer;list-style:none}.glc-switcher summary::-webkit-details-marker{display:none}.glc-switcher nav{position:absolute;top:44px;right:0;display:grid;width:min(310px,80vw);padding:8px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.98);box-shadow:var(--shadow)}.glc-switcher nav a{display:grid;grid-template-columns:28px 1fr;gap:8px;padding:9px;border-radius:9px}.glc-switcher nav a:hover,.glc-switcher nav a:focus-visible,.glc-switcher nav a[aria-current='page']{background:var(--blue-soft);outline:0}.glc-switcher nav span{color:#7c91a7;font-size:.57rem;font-weight:800}.glc-switcher nav strong{font-size:.68rem;color:#294b68}

  .glc-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(250px,.65fr);gap:24px;align-items:end;padding:42px 4px 24px}.glc-hero h1{max-width:850px;margin:7px 0 12px;font-size:clamp(2.6rem,5vw,5.4rem);line-height:.94}.glc-hero p:last-child{max-width:820px;margin:0;color:#536d86;font-size:.92rem;line-height:1.6}.glc-role-card{display:grid;gap:7px;padding:20px}.glc-role-card span{color:var(--blue);font-size:.59rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.glc-role-card strong{font-size:.88rem;color:#173955}.glc-role-card small{font-size:.61rem;color:#7a8da1}

  .glc-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:10px}.glc-kpis article{display:grid;min-height:118px;align-content:center;gap:4px;padding:18px}.glc-kpis span{color:#758ba0;font-size:.56rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.glc-kpis strong{font-size:1.25rem;color:#174b86}.glc-kpis small{font-size:.62rem;color:#637d96;line-height:1.35}

  .glc-main-grid{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(280px,.75fr);gap:10px;margin-bottom:10px}.glc-policy-panel,.glc-decisions,.glc-backlog,.glc-value{padding:20px}.glc-policy-panel header,.glc-decisions header,.glc-backlog header,.glc-value header{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:17px}.glc-policy-panel header span,.glc-decisions header span,.glc-backlog header span,.glc-value header span{color:#7089a1;font-size:.56rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.glc-policy-panel h2,.glc-decisions h2,.glc-backlog h2,.glc-value h2{max-width:540px;margin:0;font-size:1.05rem;line-height:1.2;text-align:right}

  .glc-context-row{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:15px}.glc-context-row span{padding:7px 10px;border-radius:999px;background:rgba(231,241,255,.85);color:#476883;font-size:.56rem;font-weight:700;animation:glcLift .45s ease both}.glc-context-row span:nth-child(2){animation-delay:.05s}.glc-context-row span:nth-child(3){animation-delay:.1s}.glc-context-row span:nth-child(4){animation-delay:.15s}.glc-context-row span:nth-child(5){animation-delay:.2s}
  .glc-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:8px;align-items:stretch}.glc-flow>i{display:grid;place-items:center;color:#6da1d7;font-style:normal;animation:glcPulse 1.8s ease-in-out infinite}.glc-flow-node{display:grid;min-height:136px;align-content:center;gap:5px;padding:15px;border:1px solid rgba(37,99,235,.1);border-radius:14px;background:rgba(255,255,255,.72);animation:glcLift .45s ease both}.glc-flow-node:nth-of-type(2){animation-delay:.08s}.glc-flow-node:nth-of-type(3){animation-delay:.16s}.glc-flow-node:nth-of-type(4){animation-delay:.24s}.glc-flow-node small{font-size:.52rem;color:#7c91a7;font-weight:800}.glc-flow-node strong{font-size:.75rem;color:#1d405e}.glc-flow-node span{font-size:.59rem;color:#70879d;line-height:1.4}.glc-flow-node.is-policy{background:linear-gradient(145deg,#133552,#1c507c)}.glc-flow-node.is-policy small,.glc-flow-node.is-policy strong,.glc-flow-node.is-policy span{color:#fff}.glc-flow-node.is-result{background:linear-gradient(145deg,rgba(219,234,254,.95),rgba(255,255,255,.82))}.glc-callout{display:grid;grid-template-columns:130px 1fr;gap:15px;margin-top:13px;padding:12px 14px;border-radius:12px;background:#102a44}.glc-callout span{color:#b8d7f5;font-size:.55rem;font-weight:800;text-transform:uppercase}.glc-callout strong{color:#fff;font-size:.69rem;line-height:1.45}

  .glc-decisions{display:grid;align-content:start}.glc-decision-row{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:15px 0;border-top:1px solid var(--line)}.glc-decision-row>span{display:grid;width:24px;height:24px;place-items:center;border-radius:7px;background:var(--blue-soft);color:var(--blue);font-size:.53rem;font-weight:800}.glc-decision-row div{display:grid;gap:4px}.glc-decision-row strong{font-size:.72rem;color:#254660}.glc-decision-row small{font-size:.61rem;color:#71869a;line-height:1.42}

  .glc-support-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,.65fr);gap:10px;margin-bottom:10px}.glc-backlog-track{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:7px;align-items:center}.glc-backlog-track>i{color:#74a1ce;font-style:normal}.glc-backlog-track>div{display:grid;gap:3px;padding:13px;border-radius:12px;background:rgba(239,246,255,.77)}.glc-backlog-track span{color:#6f89a2;font-size:.5rem;font-weight:800}.glc-backlog-track strong{font-size:.65rem;color:#274b69}.glc-backlog-track small{font-size:.54rem;color:#74889b;line-height:1.35}
  .glc-value{display:grid;align-content:start}.glc-value-metric{display:grid;gap:2px;padding:12px 0 15px;border-top:1px solid var(--line)}.glc-value-metric strong{font-size:2.6rem;color:#1f67bd;line-height:1}.glc-value-metric span{font-size:.67rem;font-weight:700;color:#2f526f}.glc-value-signal{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 0;border-top:1px solid var(--line)}.glc-value-signal span{font-size:.6rem;color:#72889c}.glc-value-signal strong{font-size:.72rem;color:#244b6d}.glc-evidence-note{display:block;margin-top:8px;color:#8999a8;font-size:.52rem;line-height:1.35}

  .glc-depth{overflow:hidden}.glc-depth summary{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 18px;cursor:pointer;list-style:none}.glc-depth summary::-webkit-details-marker{display:none}.glc-depth summary span{font-size:.68rem;font-weight:750;color:#294a68}.glc-depth summary strong{padding:6px 9px;border-radius:999px;background:var(--blue-soft);color:var(--blue);font-size:.54rem}.glc-depth-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:15px 18px 18px;border-top:1px solid var(--line)}.glc-depth-grid section>span{display:block;margin-bottom:8px;color:#748ba2;font-size:.55rem;font-weight:800;text-transform:uppercase}.glc-depth-grid ul{margin:0;padding-left:17px;color:#526e86;font-size:.65rem;line-height:1.5}.glc-depth-grid li+li{margin-top:5px}

  .glc-footer{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.glc-footer a{display:grid;gap:2px;padding:12px 2px}.glc-footer a:last-child{text-align:right}.glc-footer span{color:#8295a8;font-size:.55rem}.glc-footer strong{color:#31516d;font-size:.66rem}

  @keyframes glcLift{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
  @keyframes glcPulse{0%,100%{opacity:.35;transform:translateX(-2px)}50%{opacity:1;transform:translateX(2px)}}

  @media(max-width:980px){.glc-hero{grid-template-columns:1fr}.glc-role-card{max-width:520px}.glc-kpis{grid-template-columns:1fr 1fr}.glc-main-grid,.glc-support-grid{grid-template-columns:1fr}.glc-flow{grid-template-columns:1fr}.glc-flow>i{transform:rotate(90deg);min-height:12px}.glc-backlog-track{grid-template-columns:1fr}.glc-backlog-track>i{transform:rotate(90deg);text-align:center}.glc-policy-panel header,.glc-decisions header,.glc-backlog header,.glc-value header{display:grid;gap:5px}.glc-policy-panel h2,.glc-decisions h2,.glc-backlog h2,.glc-value h2{text-align:left}}
  @media(max-width:760px){.glc-dashboard{width:100%;padding:14px 12px 70px}.glc-commandbar{top:76px}.glc-brand small{display:none}.glc-switcher summary{padding:8px 9px;font-size:.58rem}.glc-hero{padding:28px 0 18px}.glc-hero h1{font-size:clamp(2.35rem,11vw,3.45rem)}.glc-hero p:last-child{font-size:.82rem}.glc-role-card{padding:16px}.glc-kpis{gap:8px}.glc-kpis article{min-height:105px;padding:15px}.glc-kpis strong{font-size:1.05rem}.glc-policy-panel,.glc-decisions,.glc-backlog,.glc-value{padding:16px}.glc-context-row{gap:5px}.glc-flow-node{min-height:94px}.glc-callout{grid-template-columns:1fr;gap:4px}.glc-depth-grid{grid-template-columns:1fr}.glc-footer{grid-template-columns:1fr 1fr}}
  @media(prefers-reduced-motion:reduce){.glc-context-row span,.glc-flow-node,.glc-flow>i{animation:none!important}}
</style>

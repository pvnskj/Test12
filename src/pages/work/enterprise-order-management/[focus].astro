---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnterpriseOrderManagementFocus from '../../../components/EnterpriseOrderManagementFocus.astro';
import { eomFocusAreas, type EomFocusArea } from '../../../data/eomCase';

export function getStaticPaths() {
  return eomFocusAreas.map((focus) => ({ params: { focus: focus.slug }, props: { focus } }));
}

interface Props { focus: EomFocusArea; }
const { focus } = Astro.props;
---

<BaseLayout
  title={`${focus.title} | Enterprise Order Management | Venkata Parimi`}
  description={`${focus.purpose} Detailed product case study covering ownership, decisions, trade-offs, system flow, and qualified evidence.`}
  bareMain
>
  <EnterpriseOrderManagementFocus focus={focus} />
</BaseLayout>

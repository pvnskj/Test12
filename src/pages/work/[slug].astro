---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDashboardV6 from '../../components/ProjectDashboardV6.astro';
import GLCodingCaseStudy from '../../components/GLCodingCaseStudy.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Venkata Parimi`}
  description={`${project.question} ${project.productGoal}`}
  bareMain
>
  {project.slug === 'gl-coding' ? (
    <GLCodingCaseStudy project={project} />
  ) : (
    <ProjectDashboardV6 project={project} />
  )}
</BaseLayout>

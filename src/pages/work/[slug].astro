---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlCodingDashboard from '../../components/GlCodingDashboard.astro';
import ProjectWorkspaceV5 from '../../components/ProjectWorkspaceV5.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isGlCodingPilot = project.slug === 'gl-coding';
---

<BaseLayout
  title={`${project.title} | Venkata Parimi`}
  description={`${project.question} ${project.productGoal}`}
  bareMain
>
  {isGlCodingPilot ? <GlCodingDashboard project={project} /> : <ProjectWorkspaceV5 project={project} />}
</BaseLayout>

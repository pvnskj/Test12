---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnterpriseOrderManagementEpic from '../../components/EnterpriseOrderManagementEpic.astro';
import ProjectEpicWorkspace from '../../components/ProjectEpicWorkspace.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
const isEnterpriseOrderManagement = project.slug === 'enterprise-order-management';
---

<BaseLayout
  title={`${project.title} | Venkata Parimi`}
  description={`${project.question} ${project.productGoal}`}
  bareMain
>
  {isEnterpriseOrderManagement
    ? <EnterpriseOrderManagementEpic />
    : <ProjectEpicWorkspace project={project} />}
</BaseLayout>

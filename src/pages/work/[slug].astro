---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectWorkspace from '../../components/ProjectWorkspace.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Venkata Parimi`}
  description={`${project.question} ${project.productGoal}`}
  bareMain
>
  <ProjectWorkspace project={project} />
</BaseLayout>

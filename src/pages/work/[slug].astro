---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemGlyph from '../../components/SystemGlyph.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const impactHref = `${base}deep-dives/${encodeURIComponent(project.impactFile)}`;
const whitepaperHref = project.whitepaperFile ? `${base}deep-dives/${encodeURIComponent(project.whitepaperFile)}` : undefined;
const nextProject = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length]!;
---

<BaseLayout title={`${project.title} | Venkata Parimi`} description={`${project.headline} ${project.summary}`}>
  <article class="case-study">
    <section class="case-hero shell">
      <a class="back-link" href={`${base}#work`}><span aria-hidden="true">←</span> Back to work</a>
      <div class="case-counter">{project.index} / {String(projects.length).padStart(2, '0')}</div>

      <div class="case-hero-grid">
        <div class="case-hero-copy" data-reveal>
          <p class="eyebrow">{project.eyebrow}</p>
          <h1>{project.headline}</h1>
          <p class="case-summary">{project.summary}</p>
          <div class="project-tags project-tags--large" role="group" aria-label={`${project.title} themes`}>
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
        <div class="case-hero-visual glass-card" data-reveal>
          <SystemGlyph variant={project.visual} label={`${project.title} system illustration`} />
          <div class="case-visual-caption"><span>System lens</span><strong>{project.category}</strong></div>
        </div>
      </div>

      {project.metrics.length > 0 && (
        <div class="case-metrics glass-panel" data-reveal>
          {project.metrics.map((metric) => (
            <div><strong>{metric.value}</strong><span>{metric.label}</span><small>{metric.detail}</small></div>
          ))}
        </div>
      )}

      {project.sourceNote && (
        <aside class="source-review glass-panel" data-reveal>
          <span class="source-review-icon" aria-hidden="true">!</span>
          <div><strong>Source review note</strong><p>{project.sourceNote}</p></div>
        </aside>
      )}
    </section>

    <nav class="case-subnav glass-bar" aria-label="Case study sections">
      <div class="shell case-subnav-inner">
        <a href="#context">Context</a><a href="#system">System</a><a href="#operating-pattern">Operating pattern</a>
        <a href="#evidence">Evidence</a><a href="#source-material">Source material</a>
      </div>
    </nav>

    <section id="context" class="case-section shell">
      <div class="case-section-label" data-reveal><span>01</span><p class="eyebrow">Context</p></div>
      <div class="case-section-content" data-reveal>
        <h2>{project.title}</h2><p class="case-lede">{project.summary}</p>
        <p>
          This case study is assembled from material already present in the portfolio repository.
          The redesign changes hierarchy and presentation without adding employers, responsibilities,
          outcomes, or metrics that are absent from those source files.
        </p>
      </div>
    </section>

    <section id="system" class="case-section shell">
      <div class="case-section-label" data-reveal><span>02</span><p class="eyebrow">System at a glance</p></div>
      <div class="case-section-content" data-reveal>
        <h2>Make the moving parts understandable.</h2>
        <p>
          The source material repeatedly describes systems as flows: signals enter, rules or contracts
          establish trust, decisions route work, and evidence is preserved. This layer makes that
          structure visible before asking a reader to open a long whitepaper.
        </p>
        <div class="flow-diagram glass-card" role="group" aria-label={`${project.title} conceptual flow`}>
          {project.flow.map((step, index) => (
            <>
              <div class="flow-node"><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></div>
              {index < project.flow.length - 1 && <div class="flow-arrow" aria-hidden="true">→</div>}
            </>
          ))}
        </div>
        <p class="diagram-note">This infographic summarizes terminology already present in the source material; it is not a new architecture claim.</p>
      </div>
    </section>

    <section id="operating-pattern" class="case-section shell">
      <div class="case-section-label" data-reveal><span>03</span><p class="eyebrow">Operating pattern</p></div>
      <div class="case-section-content" data-reveal>
        <h2>Sense → decide → act → prove.</h2>
        <div class="operating-grid">
          <article class="glass-card"><span>01</span><strong>Sense</strong><p>Establish trusted inputs, contracts, and signal quality before downstream action.</p></article>
          <article class="glass-card"><span>02</span><strong>Decide</strong><p>Apply rules, policy, risk, and product context to determine the next action.</p></article>
          <article class="glass-card"><span>03</span><strong>Act</strong><p>Route work to the right system or owner with clear operational guardrails.</p></article>
          <article class="glass-card"><span>04</span><strong>Prove</strong><p>Preserve lineage, outcomes, or audit evidence so impact can be inspected later.</p></article>
        </div>
      </div>
    </section>

    <section id="evidence" class="case-section shell">
      <div class="case-section-label" data-reveal><span>04</span><p class="eyebrow">Evidence</p></div>
      <div class="case-section-content" data-reveal>
        <h2>Claims stay attached to their source.</h2>
        {project.metrics.length > 0 ? (
          <div class="evidence-table glass-card">
            {project.metrics.map((metric) => (
              <div class="evidence-row"><strong>{metric.value}</strong><div><span>{metric.label}</span><small>{metric.detail}</small></div></div>
            ))}
          </div>
        ) : (
          <div class="source-review glass-panel">
            <span class="source-review-icon" aria-hidden="true">!</span>
            <div><strong>Quantitative impact withheld</strong><p>The available source is marked as placeholder material, so the redesign retains the project without promoting those numbers as final evidence.</p></div>
          </div>
        )}
      </div>
    </section>

    <section id="source-material" class="case-section shell">
      <div class="case-section-label" data-reveal><span>05</span><p class="eyebrow">Deep dive</p></div>
      <div class="case-section-content" data-reveal>
        <h2>Go from executive scan to technical detail.</h2>
        <p>The redesigned case study is the fast-reading layer. Existing impact decks and whitepapers remain available as source artifacts for deeper inspection.</p>
        <div class="source-links">
          <a class="source-link glass-card" href={impactHref}>
            <span class="eyebrow">Existing artifact</span><strong>Impact page</strong>
            <p>Open the original project impact material retained from Test12.</p><span class="text-link">Open impact source →</span>
          </a>
          {whitepaperHref ? (
            <a class="source-link glass-card" href={whitepaperHref}>
              <span class="eyebrow">Existing artifact</span><strong>Whitepaper / technical deep dive</strong>
              <p>Open the original long-form technical material retained from Test12.</p><span class="text-link">Open whitepaper →</span>
            </a>
          ) : (
            <div class="source-link glass-card source-link--disabled">
              <span class="eyebrow">Source review</span><strong>Whitepaper withheld</strong>
              <p>The current file does not match this project, so it is not being presented as supporting evidence.</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="next-project shell">
      <div class="next-project-card glass-card" data-reveal>
        <span class="eyebrow">Next system · {nextProject.index}</span><h2>{nextProject.title}</h2><p>{nextProject.headline}</p>
        <a class="button button-primary" href={`${base}work/${nextProject.slug}/`}>Continue to case study →</a>
      </div>
    </section>
  </article>
</BaseLayout>

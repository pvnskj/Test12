---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

type WorkspaceMeta = {
  key: string;
  summary: string;
  tags: string[];
  metric: string;
  metricLabel: string;
  metricType: 'Measured' | 'Observed' | 'Governed';
  tone: string;
};

const workspaceMeta: Record<string, WorkspaceMeta> = {
  'enterprise-order-management': {
    key: 'EPIC-01',
    summary: 'Move fulfillment from manually modeled workflow paths to dependency-driven orchestration.',
    tags: ['Platform', 'Orchestration', 'Telecom'],
    metric: '20%',
    metricLabel: 'faster logic mapping',
    metricType: 'Measured',
    tone: 'blue',
  },
  'rag-analysis-agent': {
    key: 'EPIC-02',
    summary: 'Turn fragmented engineering knowledge into grounded, traceable product intelligence.',
    tags: ['AI', 'Knowledge', 'Engineering'],
    metric: '~6 days → ~2 hrs',
    metricLabel: 'analysis cycle',
    metricType: 'Measured',
    tone: 'indigo',
  },
  'build-plus': {
    key: 'EPIC-03',
    summary: 'Connect trusted part data, demand, fulfillment, custody, and recovery into one operating model.',
    tags: ['Operations', 'Supply Chain', 'Data'],
    metric: '18 months',
    metricLabel: 'demand horizon',
    metricType: 'Observed',
    tone: 'amber',
  },
  rfds: {
    key: 'EPIC-04',
    summary: 'Turn engineering documents into governed, rules-driven outputs instead of manual artifacts.',
    tags: ['Automation', 'Engineering', 'Data'],
    metric: '$1.2M',
    metricLabel: 'annual cost avoidance',
    metricType: 'Measured',
    tone: 'rose',
  },
  'gl-coding': {
    key: 'EPIC-05',
    summary: 'Separate changing accounting policy from application architecture through configurable routing.',
    tags: ['Finance', 'ERP', 'Controls'],
    metric: '40%',
    metricLabel: 'faster financial close',
    metricType: 'Measured',
    tone: 'violet',
  },
  'lease-vendor-management': {
    key: 'EPIC-06',
    summary: 'Turn recurring lease obligations into a controlled, traceable lease-to-pay workflow.',
    tags: ['Finance', 'Lease-to-Pay', 'Governance'],
    metric: '$23.7M',
    metricLabel: 'monthly rent roll',
    metricType: 'Governed',
    tone: 'cyan',
  },
};

const domains = ['All 6', 'Platforms', 'AI & Data', 'Operations', 'Finance'];
---

<BaseLayout>
  <div class="workspace-home shell">
    <section class="workspace-hero" aria-labelledby="portfolio-title">
      <div class="workspace-hero-copy">
        <p class="eyebrow">Product portfolio</p>
        <h1 id="portfolio-title">From complex problems to scalable products.</h1>
        <p class="workspace-lede">
          Six enterprise initiatives presented as product epics—what problem mattered, where the product moved, what changed, and what the evidence actually means.
        </p>

        <div class="workspace-summary" aria-label="Portfolio summary">
          <div><strong>6</strong><span>Selected initiatives</span></div>
          <div><strong>4</strong><span>Product domains</span></div>
          <div><strong>1</strong><span>Consistent decision model</span></div>
        </div>
      </div>

      <aside class="workspace-model glass-card" aria-label="Product decision model">
        <div class="workspace-model-head">
          <span>How the work is organized</span>
          <small>one product view</small>
        </div>
        <div class="workspace-stack" aria-hidden="true">
          <div><span>01</span><strong>Problem</strong><small>What was constrained?</small></div>
          <div><span>02</span><strong>Product direction</strong><small>Why did it move this way?</small></div>
          <div><span>03</span><strong>Focus areas</strong><small>What capabilities changed?</small></div>
          <div><span>04</span><strong>Evidence</strong><small>What do the numbers mean?</small></div>
        </div>
      </aside>
    </section>

    <section id="work" class="portfolio-workspace" aria-labelledby="work-title">
      <div class="workspace-toolbar glass-card">
        <div class="workspace-title-block">
          <span class="workspace-kicker">Portfolio / Epics</span>
          <div>
            <h2 id="work-title">Selected product epics</h2>
            <span class="workspace-count">6 initiatives</span>
          </div>
        </div>

        <nav class="workspace-tabs" aria-label="Portfolio views">
          <span class="is-active">Portfolio</span>
          <span>Decisions</span>
          <span>Outcomes</span>
        </nav>
      </div>

      <div class="workspace-filterbar" aria-label="Portfolio filters">
        <div class="workspace-filters">
          {domains.map((domain, index) => <span class:list={{ 'is-active': index === 0 }}>{domain}</span>)}
        </div>
        <span class="workspace-filter-note">Open an epic for the full product story →</span>
      </div>

      <div class="epic-list glass-card">
        <div class="epic-list-head" aria-hidden="true">
          <span>Epic</span>
          <span>Product problem / direction</span>
          <span>Evidence</span>
          <span></span>
        </div>

        {projects.map((project) => {
          const meta = workspaceMeta[project.slug];
          if (!meta) return null;
          return (
            <a class="epic-row" href={`${import.meta.env.BASE_URL}work/${project.slug}/`}>
              <div class={`epic-icon epic-icon--${meta.tone}`} aria-hidden="true">
                <span>{project.index}</span>
              </div>

              <div class="epic-main">
                <span class="epic-key">{meta.key}</span>
                <h3>{project.title}</h3>
                <p>{meta.summary}</p>
                <div class="epic-tags" aria-label={`${project.title} tags`}>
                  {meta.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>

              <div class="epic-evidence">
                <span>{meta.metricType}</span>
                <strong>{meta.metric}</strong>
                <small>{meta.metricLabel}</small>
              </div>

              <span class="epic-arrow" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </section>

    <section id="approach" class="workspace-footer-grid" aria-label="Portfolio principles">
      <article class="workspace-quote glass-card">
        <span class="quote-mark" aria-hidden="true">“</span>
        <p>I bridge business strategy, product execution, and technical constraints so complex systems can change without losing clarity, control, or measurable value.</p>
      </article>

      <article id="about" class="workspace-note glass-card">
        <span>Portfolio design principle</span>
        <strong>Show the decision, not the ceremony.</strong>
        <p>The work is organized around product problems, focus areas, trade-offs, and evidence—not sprint theater or internal delivery terminology.</p>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .workspace-home{padding-bottom:72px}
  .workspace-hero{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.72fr);gap:26px;align-items:stretch;padding:58px 0 30px}
  .workspace-hero-copy{display:flex;flex-direction:column;justify-content:center;padding:36px 14px 28px 0}
  .workspace-hero-copy .eyebrow{margin-bottom:18px}
  .workspace-hero-copy h1{max-width:820px;margin:0 0 22px;font-size:clamp(3.45rem,6.6vw,6.35rem);line-height:.94;letter-spacing:-.055em}
  .workspace-lede{max-width:760px;margin:0;color:#587087;font-size:1.02rem;line-height:1.68}

  .workspace-summary{display:flex;flex-wrap:wrap;gap:0;margin-top:32px}
  .workspace-summary div{display:grid;min-width:145px;gap:1px;padding:0 26px 0 0;margin-right:26px;border-right:1px solid rgba(15,23,42,.09)}
  .workspace-summary div:last-child{border-right:0}
  .workspace-summary strong{font-size:1.42rem;color:#13365a}
  .workspace-summary span{font-size:.67rem;color:#7890a5}

  .workspace-model{position:relative;display:grid;align-content:start;gap:20px;overflow:hidden;padding:26px}
  .workspace-model:before{position:absolute;inset:-22% -10% auto 28%;height:250px;background:radial-gradient(circle,rgba(156,190,255,.2),transparent 68%);content:'';pointer-events:none}
  .workspace-model-head{position:relative;z-index:1;display:flex;justify-content:space-between;gap:18px;padding-bottom:14px;border-bottom:1px solid rgba(15,23,42,.07)}
  .workspace-model-head span{font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#516d89}
  .workspace-model-head small{font-size:.65rem;color:#93a4b6}
  .workspace-stack{position:relative;z-index:1;display:grid;gap:9px}
  .workspace-stack div{display:grid;grid-template-columns:34px 145px 1fr;align-items:center;gap:12px;padding:14px 15px;border:1px solid rgba(37,99,235,.08);border-radius:14px;background:linear-gradient(135deg,rgba(255,255,255,.78),rgba(240,246,255,.52));box-shadow:inset 0 1px 0 rgba(255,255,255,.9)}
  .workspace-stack div:nth-child(2){margin-left:16px}.workspace-stack div:nth-child(3){margin-left:32px}.workspace-stack div:nth-child(4){margin-left:48px}
  .workspace-stack span{display:grid;width:28px;height:28px;place-items:center;border-radius:9px;background:rgba(224,235,255,.82);font-size:.58rem;font-weight:800;color:#315f92}
  .workspace-stack strong{font-size:.77rem;color:#1d3d5d}
  .workspace-stack small{font-size:.67rem;color:#7a8da0}

  .portfolio-workspace{padding:38px 0 18px}
  .workspace-toolbar{display:flex;min-height:92px;align-items:center;justify-content:space-between;gap:26px;padding:18px 22px;border-radius:20px}
  .workspace-title-block{display:flex;align-items:center;gap:24px}
  .workspace-kicker{padding-right:24px;border-right:1px solid rgba(15,23,42,.08);font-size:.64rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#527190}
  .workspace-title-block>div{display:flex;align-items:baseline;gap:12px}
  .workspace-title-block h2{margin:0;font-size:1.35rem;line-height:1.1;color:#163858}
  .workspace-count{font-size:.66rem;color:#8b9cad}
  .workspace-tabs{display:flex;align-items:center;gap:4px;padding:4px;border:1px solid rgba(15,23,42,.06);border-radius:12px;background:rgba(245,249,255,.66)}
  .workspace-tabs span{padding:8px 13px;border-radius:9px;font-size:.67rem;font-weight:700;color:#71879c}
  .workspace-tabs .is-active{background:rgba(255,255,255,.96);box-shadow:0 4px 15px rgba(31,65,112,.08);color:#1f4f7d}

  .workspace-filterbar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:17px 4px 13px}
  .workspace-filters{display:flex;flex-wrap:wrap;gap:7px}
  .workspace-filters span{padding:6px 11px;border:1px solid rgba(37,99,235,.08);border-radius:999px;background:rgba(255,255,255,.62);font-size:.64rem;font-weight:700;color:#607a93}
  .workspace-filters .is-active{border-color:rgba(37,99,235,.22);background:#2f65c8;color:#fff;box-shadow:0 7px 18px rgba(37,99,235,.15)}
  .workspace-filter-note{font-size:.66rem;color:#8a9bac}

  .epic-list{overflow:hidden;padding:0;border-radius:22px}
  .epic-list-head{display:grid;grid-template-columns:74px minmax(0,1fr) minmax(170px,230px) 34px;gap:18px;padding:13px 22px;border-bottom:1px solid rgba(15,23,42,.07);background:rgba(246,249,253,.5)}
  .epic-list-head span{font-size:.57rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#8ba0b4}
  .epic-row{display:grid;grid-template-columns:74px minmax(0,1fr) minmax(170px,230px) 34px;gap:18px;align-items:center;min-height:132px;padding:20px 22px;border-bottom:1px solid rgba(15,23,42,.07);transition:background .2s ease,transform .2s ease,box-shadow .2s ease}
  .epic-row:last-child{border-bottom:0}
  .epic-row:hover,.epic-row:focus-visible{position:relative;z-index:2;background:linear-gradient(90deg,rgba(246,250,255,.92),rgba(255,255,255,.75));box-shadow:inset 3px 0 0 rgba(47,101,200,.65);outline:0}

  .epic-icon{display:grid;width:48px;height:48px;place-items:center;border:1px solid rgba(255,255,255,.9);border-radius:14px;box-shadow:inset 0 1px 0 #fff,0 8px 20px rgba(52,83,128,.08)}
  .epic-icon span{font-size:.67rem;font-weight:850;color:#315d88}
  .epic-icon--blue{background:linear-gradient(145deg,#edf7ff,#e8f4ee)}
  .epic-icon--indigo{background:linear-gradient(145deg,#eef2ff,#edf7ff)}
  .epic-icon--amber{background:linear-gradient(145deg,#fff6e7,#fffaf2)}
  .epic-icon--rose{background:linear-gradient(145deg,#fff0f1,#fff7f7)}
  .epic-icon--violet{background:linear-gradient(145deg,#f2efff,#f6f4ff)}
  .epic-icon--cyan{background:linear-gradient(145deg,#eaf8ff,#f1fbff)}

  .epic-main{min-width:0}
  .epic-key{display:block;margin-bottom:3px;font-size:.58rem;font-weight:850;letter-spacing:.07em;color:#3470b1}
  .epic-main h3{margin:0 0 4px;font-size:1.02rem;line-height:1.2;color:#102f50}
  .epic-main p{max-width:790px;margin:0;color:#657d94;font-size:.73rem;line-height:1.46}
  .epic-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
  .epic-tags span{padding:4px 8px;border-radius:999px;background:rgba(234,242,253,.76);font-size:.55rem;font-weight:700;color:#55728f}

  .epic-evidence{display:grid;gap:2px;padding-left:20px;border-left:1px solid rgba(15,23,42,.07)}
  .epic-evidence>span{font-size:.52rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#8295a8}
  .epic-evidence strong{font-size:1.03rem;line-height:1.18;color:#2158bf}
  .epic-evidence small{font-size:.64rem;line-height:1.35;color:#71879c}
  .epic-arrow{font-size:1rem;color:#4b76a1;transition:transform .18s ease}
  .epic-row:hover .epic-arrow{transform:translateX(4px)}

  .workspace-footer-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(330px,.88fr);gap:14px;padding:34px 0 0}
  .workspace-quote,.workspace-note{min-height:160px;padding:26px 28px}
  .workspace-quote{position:relative;display:flex;align-items:center;padding-left:68px}
  .quote-mark{position:absolute;left:25px;top:22px;font-family:Georgia,serif;font-size:3.5rem;line-height:1;color:#d8e6f8}
  .workspace-quote p{max-width:820px;margin:0;color:#23415e;font-size:.95rem;line-height:1.65}
  .workspace-note{display:grid;align-content:center;gap:6px}
  .workspace-note>span{font-size:.56rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#7a92aa}
  .workspace-note strong{font-size:.98rem;color:#173a5b}
  .workspace-note p{margin:2px 0 0;color:#71869a;font-size:.72rem;line-height:1.5}

  @media(max-width:980px){
    .workspace-hero,.workspace-footer-grid{grid-template-columns:1fr}
    .workspace-hero-copy{padding-right:0}
    .workspace-toolbar{align-items:flex-start;flex-direction:column}
    .workspace-tabs{align-self:stretch;justify-content:center}
    .epic-list-head{display:none}
    .epic-row{grid-template-columns:58px minmax(0,1fr) 28px}
    .epic-evidence{grid-column:2;padding:10px 0 0;border-left:0;border-top:1px solid rgba(15,23,42,.07)}
    .epic-arrow{grid-column:3;grid-row:1/3}
  }

  @media(max-width:640px){
    .workspace-hero{padding-top:38px}
    .workspace-hero-copy h1{font-size:clamp(3rem,14vw,4.35rem)}
    .workspace-summary{gap:14px}
    .workspace-summary div{min-width:0;margin-right:0;padding-right:14px}
    .workspace-model{padding:21px}
    .workspace-stack div{grid-template-columns:32px 1fr;gap:10px}
    .workspace-stack div:nth-child(n){margin-left:0}
    .workspace-stack small{grid-column:2}
    .workspace-toolbar{padding:16px}
    .workspace-title-block{align-items:flex-start;gap:12px}
    .workspace-kicker{display:none}
    .workspace-title-block>div{display:grid;gap:2px}
    .workspace-tabs span{padding-inline:10px}
    .workspace-filterbar{align-items:flex-start;flex-direction:column}
    .workspace-filter-note{display:none}
    .epic-row{grid-template-columns:46px minmax(0,1fr) 22px;gap:10px;min-height:0;padding:18px 15px}
    .epic-icon{width:40px;height:40px;border-radius:12px}
    .epic-main p{font-size:.69rem}
    .epic-evidence strong{font-size:.96rem}
    .workspace-quote{padding-left:54px}
    .quote-mark{left:18px}
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects, projects } from '../data/projects';

const expertise = [
  {
    title: 'Enterprise systems orchestration',
    body: 'Products that sit between systems of record: ownership boundaries, data contracts, synchronization, reconciliation, lifecycle state, and the failure paths that appear when systems disagree.',
    examples: 'ERP · MDM · WMS · TMS · Fixed Assets',
  },
  {
    title: 'Rules & decision automation',
    body: 'Turning spreadsheet logic, engineering rules, policy, and institutional knowledge into configurable product behavior with validation, routing, exceptions, and auditability.',
    examples: 'Rules engines · Policy models · Validation',
  },
  {
    title: 'Data integrity & lifecycle design',
    body: 'Making identity, authority, state, and lifecycle transitions explicit so products remain trustworthy when data is incomplete, stale, duplicated, or contradictory.',
    examples: 'Identity · State · Lineage · Reconciliation',
  },
  {
    title: 'Operational workflow platforms',
    body: 'Converting multi-team operating processes into explicit product states: triggers, owners, handoffs, exceptions, escalation, and proof of completion.',
    examples: 'Approvals · Field work · Fulfillment · Exceptions',
  },
  {
    title: 'Technical product execution',
    body: 'Connecting Product Goals to system constraints, APIs, domain rules, edge cases, backlog ordering, release decisions, and measurable operating outcomes.',
    examples: 'Product Goal · Increments · Evidence · Adaptation',
  },
];

const approaches = [
  {
    situation: 'The problem is ambiguous',
    approach: 'Discovery & Product Goal framing',
    why: 'Align on the user, constraint, outcome, and evidence of success before solutioning consumes delivery capacity.',
    signal: 'Are we solving the right problem?',
  },
  {
    situation: 'The workflow is the problem',
    approach: 'Workflow & state modelling',
    why: 'Expose the happy path, rejection, retries, ownership changes, and exceptions before they become production surprises.',
    signal: 'What happens when the normal path breaks?',
  },
  {
    situation: 'Systems disagree about the truth',
    approach: 'Domain, identity & source-of-truth mapping',
    why: 'Clarify which system owns which state, how identity persists, and how conflicts are reconciled instead of pretending one database owns reality.',
    signal: 'Who owns this fact at this point in the lifecycle?',
  },
  {
    situation: 'Policy changes frequently',
    approach: 'Rules-driven product design',
    why: 'Separate business policy from application logic where configurability creates real agility without weakening governance.',
    signal: 'Should this change require a code release?',
  },
  {
    situation: 'The solution is uncertain',
    approach: 'Incremental validation',
    why: 'Order work around the most important assumptions, dependencies, and risks; use a usable Increment to create evidence before the next decision.',
    signal: 'What is the smallest valuable thing that reduces uncertainty?',
  },
  {
    situation: 'Stakeholders optimize for different outcomes',
    approach: 'Value & trade-off alignment',
    why: 'Make the Product Goal, expected value, risk, cost of delay, quality, and constraints visible so prioritization becomes a product decision.',
    signal: 'What creates the most value now, and what are we choosing not to do?',
  },
  {
    situation: 'The product is operating',
    approach: 'Evidence, inspection & adaptation',
    why: 'Shipping proves completion, not value. Inspect customer and operational signals, then adapt the Product Backlog when evidence contradicts the plan.',
    signal: 'Did the Increment change the outcome we cared about?',
  },
];
---

<BaseLayout>
  <section class="hero-section shell v3-hero">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">Senior Technical Product Owner · Enterprise systems</p>
      <h1>Turning complex systems<br />into products people can trust.</h1>
      <p class="hero-lede v3-hero-lede">
        I work on products where the difficult part sits beneath the interface: business rules, data
        ownership, enterprise integrations, operational workflows, risk, and delivery dependencies. My
        role is to make that complexity explicit enough to make better product decisions, ship usable
        Increments, and improve the outcome with evidence.
      </p>

      <div class="v3-positioning-line" aria-label="Product ownership focus">
        <span>Product strategy</span><i>→</i><span>Domain & system decisions</span><i>→</i><span>Valuable Increments</span><i>→</i><span>Evidence & adaptation</span>
      </div>

      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore selected initiatives <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="#approach">How I choose an approach</a>
      </div>
    </div>

    <div class="hero-system glass-card v3-hero-system" role="group" aria-label="End-to-end product ownership illustration" data-reveal>
      <div class="hero-system-label"><span>The TPO surface</span><strong>End-to-end product decisions</strong></div>
      <div class="v3-system-stack" aria-hidden="true">
        <div class="v3-stack-row"><span>Business outcome</span><small>value · risk · timing</small></div>
        <div class="v3-stack-connector"></div>
        <div class="v3-stack-row"><span>Product model</span><small>goal · users · states · rules</small></div>
        <div class="v3-stack-connector"></div>
        <div class="v3-stack-row"><span>System boundaries</span><small>data · APIs · ownership · failure</small></div>
        <div class="v3-stack-connector"></div>
        <div class="v3-stack-row"><span>Delivery strategy</span><small>ordering · increments · dependencies</small></div>
        <div class="v3-stack-connector"></div>
        <div class="v3-stack-row"><span>Evidence</span><small>outcome · learning · adaptation</small></div>
      </div>
      <div class="hero-system-caption">The interface is only one layer of the product.</div>
    </div>
  </section>

  <section class="proof-strip shell glass-panel v3-proof" aria-label="Portfolio focus" data-reveal>
    <div><strong>Enterprise systems</strong><span>Products spanning data, workflow, operations, finance, and systems of record.</span></div>
    <div><strong>End-to-end ownership</strong><span>Problem framing through Product Goal, decisions, delivery, evidence, and adaptation.</span></div>
    <div><strong>Technical depth</strong><span>Enough architecture fluency to make product trade-offs explicit and testable.</span></div>
    <div><strong>Outcome led</strong><span>Value, operating behavior, quality, risk, and learning over feature-volume theatre.</span></div>
  </section>

  <section id="expertise" class="section shell">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Where I operate</p><h2>My expertise is in the seams between teams, rules, data, and systems.</h2></div>
      <p>
        Technical Product Ownership is not about collecting engineering vocabulary. I go deep enough
        into the domain and system behavior to clarify ownership, expose constraints, challenge
        assumptions, reduce risk, and keep value visible when the implementation becomes complicated.
      </p>
    </div>

    <div class="v3-expertise-grid">
      {expertise.map((item, index) => (
        <article class="glass-card v3-expertise-card" data-reveal>
          <span class="v3-number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{item.title}</h3><p>{item.body}</p><small>{item.examples}</small>
        </article>
      ))}
    </div>
  </section>

  <section id="work" class="section shell">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Selected product initiatives</p><h2>Representative work from a broader product portfolio.</h2></div>
      <p>
        These initiatives are selected because they expose different kinds of Product Ownership: master
        data, system-of-systems lifecycle design, engineering automation, maintenance intelligence, and
        configurable financial policy. They are examples of how I operate—not a count of everything I have owned.
      </p>
    </div>

    <div class="featured-grid v3-featured-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} featured />)}
    </div>
  </section>

  <section class="section shell v3-operating-section">
    <div class="v3-operating-model glass-card" data-reveal>
      <div class="v3-operating-copy">
        <p class="eyebrow">The product-ownership loop</p>
        <h2>Complexity matters only when it changes a product decision.</h2>
        <p>
          Business intent becomes a Product Goal. The goal shapes the domain model, system boundaries,
          and Product Backlog order. A usable Increment creates evidence; evidence changes what I order
          next. The loop is designed to make uncertainty visible rather than hide it behind a roadmap.
        </p>
      </div>
      <div class="v3-loop" aria-label="Product ownership feedback loop">
        <div class="v3-loop-node v3-loop-node-1"><span>01</span><strong>Problem</strong><small>user · business · constraint</small></div><div class="v3-loop-arrow">→</div>
        <div class="v3-loop-node"><span>02</span><strong>Product Goal</strong><small>outcome · value · focus</small></div><div class="v3-loop-arrow">→</div>
        <div class="v3-loop-node"><span>03</span><strong>Model</strong><small>states · data · rules · risk</small></div><div class="v3-loop-arrow v3-loop-arrow-down">↓</div>
        <div class="v3-loop-node v3-loop-node-evidence"><span>04</span><strong>Increment</strong><small>usable · testable · valuable</small></div>
        <div class="v3-loop-return"><span>inspect evidence</span><i>↶</i><span>adapt the Product Backlog</span></div>
      </div>
    </div>
  </section>

  <section id="approach" class="section shell">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">How I approach product problems</p><h2>I do not use one framework for every situation.</h2></div>
      <p>
        The approach depends on what is uncertain. A stakeholder-alignment problem needs a different
        tool from a data-ownership problem. The point of a framework is to improve the next decision,
        not to demonstrate that I know the framework.
      </p>
    </div>

    <div class="v3-approach-list glass-card" data-reveal>
      {approaches.map((item, index) => (
        <article class="v3-approach-row">
          <span class="v3-number">{String(index + 1).padStart(2, '0')}</span>
          <div><small>When</small><strong>{item.situation}</strong></div>
          <div><small>Approach</small><strong>{item.approach}</strong><p>{item.why}</p></div>
          <div class="v3-approach-signal"><small>Question I want answered</small><span>{item.signal}</span></div>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" id="all-work">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">More selected work</p><h2>The portfolio stays selective without pretending the selected stories are the whole career.</h2></div>
      <p>Additional initiatives remain available for readers who want a wider view of the product surface.</p>
    </div>
    <div class="archive-list glass-card v3-archive" data-reveal>
      {projects.map((project) => (
        <a class="archive-row" href={`${import.meta.env.BASE_URL}work/${project.slug}/`}>
          <span class="archive-index">{project.index}</span>
          <div><strong>{project.title}</strong><span>{project.question}</span></div>
          <div class="archive-tags"><span>{project.category}</span></div>
          <span class="archive-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="section shell">
    <div class="about-grid v3-about">
      <div class="about-copy" data-reveal>
        <p class="eyebrow">About the portfolio</p><h2>Product Ownership beyond backlog administration.</h2>
        <p>
          I treat the Product Backlog as a decision system, not a queue of stakeholder requests. The
          Product Goal provides focus; ordering reflects value, risk, dependencies, quality, and what
          we still need to learn. Delivery matters because a usable Increment gives us something real
          to inspect—not because completing more stories is the objective.
        </p>
        <p>
          That means going deep enough into the domain and architecture to understand constraints,
          working with Developers and stakeholders to make trade-offs visible, protecting quality and
          product coherence, and adapting when evidence shows that the original plan is wrong.
        </p>
      </div>
      <div class="v3-stakeholder-graphic glass-card" data-reveal aria-label="Product Goal aligns competing stakeholder needs">
        <div class="v3-stakeholder-core"><span>Product Goal</span><strong>Shared outcome</strong></div>
        <div class="v3-stakeholder-item v3-stakeholder-a"><strong>Business</strong><small>value · speed · timing</small></div>
        <div class="v3-stakeholder-item v3-stakeholder-b"><strong>Users / Ops</strong><small>utility · clarity · flow</small></div>
        <div class="v3-stakeholder-item v3-stakeholder-c"><strong>Engineering</strong><small>quality · feasibility · debt</small></div>
        <div class="v3-stakeholder-item v3-stakeholder-d"><strong>Governance</strong><small>risk · control · evidence</small></div>
        <p>My job is not to put every request into the backlog. It is to make the trade-offs visible and maximize product value without losing the goal.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="section shell">
    <div class="contact-panel glass-card" data-reveal>
      <div><p class="eyebrow">Contact</p><h2>Continue the conversation.</h2><p>The repository still contains placeholder email and LinkedIn values, so I am not publishing invented contact details. GitHub remains the verified public destination connected to this portfolio.</p></div>
      <div class="contact-actions"><a class="button button-primary" href="https://github.com/pvnskj">GitHub profile →</a><span class="contact-pending">Email / LinkedIn pending confirmation</span></div>
    </div>
  </section>
</BaseLayout>

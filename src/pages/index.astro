---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const expertise = [
  { n:'01', title:'Enterprise orchestration', tags:['ERP / MDM / WMS','APIs','Reconciliation'] },
  { n:'02', title:'Rules & decision products', tags:['Policy','Validation','Exceptions'] },
  { n:'03', title:'Data lifecycle & integrity', tags:['Identity','State','Lineage'] },
  { n:'04', title:'Technical product execution', tags:['Product Goal','Increments','Evidence'] },
];

const approaches = [
  ['Problem unclear','Discovery + Product Goal','What outcome are we solving for?'],
  ['Workflow breaks','State modelling','Where can the flow fail?'],
  ['Systems disagree','Source-of-truth mapping','Who owns this state now?'],
  ['Policy changes','Rules-driven design','What should be configurable?'],
  ['Solution uncertain','Incremental validation','What reduces uncertainty first?'],
  ['Product is live','Evidence + adaptation','Did the outcome actually change?'],
];

const proofBySlug: Record<string,string[]> = {
  'asset-catalog':['312% projected ROI','Master data'],
  inventory:['285% projected ROI','Chain of custody'],
  rfds:['72% faster approvals','Engineering automation'],
  inspection:['345% projected ROI','Maintenance intelligence'],
  'gl-coding':['40% faster close','Configurable policy'],
  'order-fulfillment':['Cross-system lifecycle','Metrics withheld'],
  'financial-projections':['-15% forecast variance','Scenario platform'],
};
---

<BaseLayout>
  <div class="v6-home shell">
    <section class="v6-home-hero">
      <div class="v6-home-copy" data-reveal>
        <p class="eyebrow">Senior Technical Product Owner</p>
        <h1>Make complex products easy to understand.</h1>
        <p>Enterprise systems, workflow platforms, data products, and decision logic—shaped into clear product goals, buildable increments, and measurable outcomes.</p>
        <div class="v6-hero-actions">
          <a class="button button-primary" href="#work">Selected work →</a>
          <a class="button button-secondary" href="#approach">How I think</a>
        </div>
      </div>

      <div class="v6-hero-board glass-card" data-reveal aria-label="Technical Product Owner operating surface">
        <div class="v6-board-title"><span>Operating surface</span><strong>Product ownership end to end</strong></div>
        <div class="v6-control-map">
          <div class="v6-control-node"><strong>Outcome</strong><small>value · risk · timing</small></div>
          <div class="v6-control-node"><strong>Domain</strong><small>users · states · rules</small></div>
          <div class="v6-control-node"><strong>Systems</strong><small>data · APIs · ownership</small></div>
          <div class="v6-control-node"><strong>Delivery</strong><small>ordering · increments · evidence</small></div>
          <div class="v6-control-core"><span>SENIOR TPO</span><strong>Decision clarity</strong></div>
        </div>
      </div>
    </section>

    <section class="v6-band" aria-label="Portfolio focus">
      <article class="glass-card"><strong>Enterprise systems</strong><span>Products that cross platforms, teams, and operating boundaries.</span></article>
      <article class="glass-card"><strong>Technical depth</strong><span>Enough architecture fluency to make product trade-offs explicit.</span></article>
      <article class="glass-card"><strong>Product judgment</strong><span>Goals, ordering, constraints, exceptions, and value—not ticket volume.</span></article>
      <article class="glass-card"><strong>Evidence led</strong><span>Use increments to learn, then adapt what comes next.</span></article>
    </section>

    <section id="expertise" class="v6-section">
      <div class="v6-section-head" data-reveal>
        <div><p class="eyebrow">Where I operate</p><h2>The hard part is usually between systems.</h2></div>
        <p>I focus on the decisions that make complex enterprise products coherent.</p>
      </div>
      <div class="v6-expertise">
        {expertise.map((item) => <article class="glass-card" data-reveal><span>{item.n}</span><h3>{item.title}</h3><div class="v6-tagline">{item.tags.map((tag)=><span>{tag}</span>)}</div></article>)}
      </div>
    </section>

    <section id="work" class="v6-section">
      <div class="v6-section-head" data-reveal>
        <div><p class="eyebrow">Selected work</p><h2>Different problems. Different product decisions.</h2></div>
        <p>Representative initiatives from a broader body of product ownership.</p>
      </div>
      <div class="v6-work-grid">
        {projects.map((project) => (
          <a class="v6-work-card glass-card" href={`${import.meta.env.BASE_URL}work/${project.slug}/`} data-reveal>
            <div>
              <small>{project.eyebrow}</small>
              <h3>{project.title}</h3>
              <p>{project.question}</p>
              <div class="v6-card-proof">{proofBySlug[project.slug]?.map((proof)=><span>{proof}</span>)}</div>
            </div>
            <div class="v6-mini-map" aria-hidden="true"><strong>{project.index}</strong><span></span><span></span><span></span><span></span></div>
          </a>
        ))}
      </div>
    </section>

    <section id="approach" class="v6-section">
      <div class="v6-section-head" data-reveal>
        <div><p class="eyebrow">How I choose an approach</p><h2>Use the tool that matches the uncertainty.</h2></div>
        <p>No framework earns a place unless it improves the next product decision.</p>
      </div>
      <div class="v6-approach-grid">
        {approaches.map(([situation,approach,question]) => <article class="glass-card" data-reveal><small>{situation}</small><strong>{approach}</strong><span>{question}</span></article>)}
      </div>
    </section>

    <section id="about" class="v6-section v6-about-strip">
      <article class="v6-about-copy glass-card" data-reveal>
        <p class="eyebrow">Product ownership</p>
        <h2>Go deep enough to simplify the decision.</h2>
        <p>I treat the Product Backlog as a decision system: connect the Product Goal to value, risk, technical constraints, dependencies, quality, and what we still need to learn. Architecture matters when it changes the product decision; delivery matters when it creates usable evidence.</p>
      </article>
      <article id="contact" class="v6-contact-card glass-card" data-reveal>
        <p class="eyebrow">Contact</p>
        <strong>Continue the conversation.</strong>
        <span>GitHub is the verified public destination connected to this portfolio.</span>
        <a class="button button-primary" href="https://github.com/pvnskj" rel="me">GitHub profile →</a>
      </article>
    </section>
  </div>
</BaseLayout>

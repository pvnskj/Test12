---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSymbol from '../components/ProjectSymbol.astro';
import { projects } from '../data/projects';
import { projectPresentation, getEvidence } from '../data/projectPresentation';

const groups = ['All work', 'Platforms', 'AI', 'Operations', 'Finance'];
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <div class="scan-home shell">
    <section class="scan-hero" aria-labelledby="portfolio-title">
      <p class="eyebrow">Venkata Parimi · Senior Technical Product Owner</p>
      <h1 id="portfolio-title">Turning challenges into opportunity.</h1>
      <p class="scan-lede">I connect business decisions with the systems behind them.<br class="desktop-break" /> From enterprise platforms to AI products, I make complex work easier to change.</p>
    </section>

    <section id="work" class="work-board" aria-labelledby="work-title" data-work-board>
      <div class="board-heading">
        <div><p class="eyebrow">Selected product work</p><h2 id="work-title">The problem, the decision, and the evidence.</h2></div>
        <span class="board-count" aria-live="polite" data-project-count>6 projects</span>
      </div>
      <div class="board-filters" role="group" aria-label="Filter projects" data-project-filters hidden>
        {groups.map((group, index) => <button type="button" data-filter={group} aria-pressed={index === 0}>{group}</button>)}
      </div>

      <div class="scan-project-grid">
        {projects.map((project) => {
          const view = projectPresentation[project.slug]!;
          const proof = getEvidence(project)[view.proofIndex]!;
          return (
            <article class="scan-project-card" data-group={view.group} data-tone={view.tone}>
              <a class="scan-project-link" href={`${base}work/${project.slug}/`} aria-labelledby={`card-${project.slug}`}>
                <div class="card-meta"><span><i aria-hidden="true">◆</i> EPIC-{project.index}</span><span>{view.group}</span></div>
                <div class="card-title"><ProjectSymbol slug={project.slug} /><h3 id={`card-${project.slug}`}>{project.title}</h3></div>
                <p class="card-decision">{view.decision}</p>
                <div class="card-proof"><span class="proof-type">{proof.type}</span><strong>{proof.value}</strong><span>{proof.label}</span><small>{view.proofNote}</small></div>
                <div class="card-bottom"><span>{view.role}</span><b aria-hidden="true">↗</b></div>
              </a>
            </article>
          );
        })}
      </div>
    </section>

    <section id="approach" class="scan-approach" aria-labelledby="approach-title">
      <div><p class="eyebrow">How I work</p><h2 id="approach-title">Technical depth.<br /> Human judgment.</h2></div>
      <div><p>AI has changed how I think about product ownership. I use it to investigate faster and test assumptions earlier. My job is to decide what matters, make the trade-offs clear, and stay accountable for what we build.</p><p class="approach-signoff">Understand the system. Make the call. Learn from the evidence.</p></div>
    </section>
  </div>
</BaseLayout>

<script>
  function bindProjectFilters() {
    const board = document.querySelector<HTMLElement>('[data-work-board]');
    if (!board || board.dataset.bound === 'true') return;
    board.dataset.bound = 'true';
    const controls = board.querySelector<HTMLElement>('[data-project-filters]');
    const buttons = board.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = board.querySelectorAll<HTMLElement>('[data-group]');
    const count = board.querySelector<HTMLElement>('[data-project-count]');
    if (controls) controls.hidden = false;
    buttons.forEach((button) => button.addEventListener('click', () => {
      let visible = 0;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach((card) => {
        card.hidden = button.dataset.filter !== 'All work' && card.dataset.group !== button.dataset.filter;
        if (!card.hidden) visible += 1;
      });
      if (count) count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
    }));
  }
  bindProjectFilters();
  document.addEventListener('astro:page-load', bindProjectFilters);
</script>
